---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm';

const title = "Especialista en LinkedIn Ads B2B | Generación de Leads de Alto Valor (2027)";
const description = "Capta clientes corporativos, tomadores de decisión (C-Level) y cuentas clave con un especialista en LinkedIn Ads. Estrategias ABM y Lead Gen Forms.";
---

<Layout title={title} description={description} image="/images/og-linkedin-ads.png">
  <!-- Schema: Service & FAQPage JSON-LD -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "name": "Gestión y Publicidad B2B en LinkedIn Ads",
          "serviceType": "Account-Based Marketing & Publicidad B2B",
          "provider": {
            "@type": "Person",
            "name": "Fabián Pérez",
            "jobTitle": "Especialista Senior en LinkedIn Ads & Pauta B2B",
            "url": "https://fabipers.com"
          },
          "areaServed": [
            { "@type": "Country", "name": "Colombia" },
            { "@type": "Country", "name": "Estados Unidos" },
            { "@type": "Country", "name": "Latinoamérica" }
          ],
          "description": "Servicio integral de gestión, optimización y prospección en LinkedIn Ads enfocado en empresas B2B, SaaS, consultoría corporativa y servicios de alto ticket."
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Por qué LinkedIn Ads es más costoso por clic y cómo se justifica el ROI?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "El coste por clic en LinkedIn es más elevado porque compras certeza profesional: accedes a datos verificados de cargos, nivel de antigüedad, industrias y tamaño de empresa que ninguna otra red social posee. En negocios B2B o servicios de alto ticket, un solo contrato cerrado de $5,000 o $20,000 USD compensa con creces el costo por lead, logrando un retorno sobre la inversión (ROI) exponencial."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué presupuesto mínimo de inversión se requiere para que LinkedIn Ads funcione?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Para empresas en Colombia y Latinoamérica recomiendo iniciar con un presupuesto de pauta de al menos $800 a $1,500 USD al mes. Para campañas dirigidas a Estados Unidos y Europa, el mínimo sugerido es de $2,000 a $3,500 USD al mes. Esto permite pujar con solvencia en las subastas de LinkedIn, alimentar el algoritmo y conseguir un volumen estadístico sólido de prospectos calificados."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué son los Lead Gen Forms nativos y por qué superan a las landing pages en B2B?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Los Lead Gen Forms son formularios integrados directamente en el feed de LinkedIn. Cuando un profesional pulsa tu anuncio, el formulario se auto-rellena al instante con su nombre, correo corporativo, cargo y empresa según su perfil verificado. Esto elimina la fricción de navegación externa y suele triplicar la tasa de conversión en comparación con una landing page tradicional."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué es una estrategia de Account-Based Marketing (ABM) con Matched Audiences?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Es la técnica más poderosa de LinkedIn Ads: nos permite cargar una lista específica de empresas objetivo (target accounts) que tu equipo comercial desea cerrar. El algoritmo de LinkedIn cruza la lista y muestra tus anuncios exclusivamente a los tomadores de decisión (CEOs, CFOs, Directores de TI, etc.) de esas organizaciones, cercando comercialmente al comité evaluador."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cómo conectamos los prospectos de LinkedIn con nuestro CRM?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Integro tus campañas directamente con HubSpot, Salesforce, Zoho, ActiveCampaign o mediante Webhooks y Zapier/Make. Cada vez que un tomador de decisión completa un Lead Gen Form, los datos ingresan en tiempo real a tu pipeline comercial y disparan alertas inmediatas por correo o Slack para que tus ejecutivos atiendan el prospecto en minutos."
              }
            },
            {
              "@type": "Question",
              "name": "¿Quién es el propietario de la cuenta publicitaria y de los datos de prospección?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Tu empresa es la única y legítima dueña del 100% de la cuenta en LinkedIn Campaign Manager, de las audiencias creadas y de cada registro captado. Yo administro la cuenta con acceso delegado de especialista. Toda la información histórica y estratégica permanece siempre bajo tu absoluto control."
              }
            }
          ]
        }
      ]
    }
  </script>

  <!-- Hero Section con Formulario en Parte Superior Derecha -->
  <section class="section service-hero-detail" id="hero">
    <div class="container srv-hero-grid">
      <!-- Columna Izquierda: Mensaje Comercial y Autoridad B2B -->
      <div class="srv-hero-content">
        <div class="badge-wrapper">
          <span class="hero-badge rotate-left">⚡ ESPECIALISTA EN PUBLICIDAD B2B & ABM</span>
        </div>
        <h1 class="hero-title">
          Especialista en <span class="highlight-text">LinkedIn Ads</span>: Prospectos Calificados para Negocios B2B
        </h1>
        <p class="hero-subtitle">
          No desperdicies tu presupuesto en clics de estudiantes o curiosos. Como consultor senior en pauta digital corporativa, diseño y administro campañas de precisión milimétrica en <strong>LinkedIn Campaign Manager</strong> para conectar tu oferta de alto valor directamente con directores, gerentes, decisores C-Level y comités de compra en Colombia, Estados Unidos y Latinoamérica.
        </p>

        <!-- Viñetas de Autoridad B2B -->
        <div class="hero-bullet-list">
          <div class="hero-bullet-item">
            <span class="bullet-icon">🎯</span>
            <div>
              <strong>Segmentación Quirúrgica por Cargo & Empresa:</strong> Impacta exactamente a Directores de Operaciones, TI, Finanzas o CEOs en las industrias que te interesan.
            </div>
          </div>
          <div class="hero-bullet-item">
            <span class="bullet-icon">⚡</span>
            <div>
              <strong>Lead Gen Forms Nativos con Auto-Relleno:</strong> Formularios integrados en el feed que multiplican la tasa de captura sin fricción de carga web.
            </div>
          </div>
          <div class="hero-bullet-item">
            <span class="bullet-icon">🏢</span>
            <div>
              <strong>Account-Based Marketing (ABM) Real:</strong> Pautamos sobre tu lista de empresas objetivo (cuentas soñadas) y nutrimos a su comité evaluador.
            </div>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#formulario-contacto" class="btn btn-primary" id="linkedin-cta-quote-top">
            ⚡ Cotizar Estrategia B2B
          </a>
          <a href="https://api.whatsapp.com/send?phone=+573182873558&text=Hola%20Fabi%C3%A1n,%20quiero%20cotizar%20la%20gesti%C3%B3n%20de%20campa%C3%B1as%20de%20LinkedIn%20Ads%20B2B" class="btn btn-whatsapp" id="linkedin-cta-whatsapp" target="_blank" rel="noopener noreferrer">
            💬 WhatsApp (+57 318 287 3558)
          </a>
          <a href="#entregables" class="btn btn-secondary" id="linkedin-cta-deliverables">
            Ver Entregables &darr;
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Formulario Superior Directo -->
      <div class="srv-hero-form-col">
        <div class="google-partner-hero-bar">
          <div class="gp-bar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="#0077b5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="2" y="9" width="4" height="12" stroke="#0077b5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="4" cy="4" r="2" stroke="#0077b5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="gp-bar-text">
            <strong>B2B Audience Intelligence & ABM</strong>
            <span class="gp-subtle-sep">•</span>
            <span class="gp-subtle-desc">Decisores C-Level & Cuentas Clave</span>
          </div>
        </div>

        <LeadForm 
          client:load 
          locationName="B2B & High-Ticket"
          formTitle="Cotiza tu Campaña B2B en LinkedIn Ads"
          formSubtitle="Analizaré tu modelo de negocio y tu perfil de cliente ideal (ICP) para diseñar una propuesta de prospección corporativa en menos de 24h."
          tagText="⚡ PROPUESTA EN 24H"
          sourcePage="landing_servicio_linkedin_ads"
          defaultService="LinkedIn Ads para B2B / High-Ticket"
        />

        <div class="hero-form-trust">
          <span>🔒 Confidencialidad total con NDA</span>
          <span>•</span>
          <span>Sin contratos de permanencia forzosa</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Barra de Métricas y Autoridad (Ribbon Compacto) -->
  <section class="authority-metrics-bar">
    <div class="container">
      <div class="metrics-compact-grid">
        <div class="metric-compact-item">
          <span class="metric-number">10+ Años</span>
          <div class="metric-info">
            <strong class="metric-title">Experiencia Práctica</strong>
            <span class="metric-caption">Especialista dedicado en pauta B2B</span>
          </div>
        </div>
        <div class="metric-compact-item">
          <span class="metric-number">C-Level</span>
          <div class="metric-info">
            <strong class="metric-title">Segmentación Exacta</strong>
            <span class="metric-caption">Directores y comités de compra reales</span>
          </div>
        </div>
        <div class="metric-compact-item">
          <span class="metric-number">3.2x ROI</span>
          <div class="metric-info">
            <strong class="metric-title">Retorno Promedio B2B</strong>
            <span class="metric-caption">En contratos corporativos y consultoría</span>
          </div>
        </div>
        <div class="metric-compact-item">
          <span class="metric-number">100% Tuyo</span>
          <div class="metric-info">
            <strong class="metric-title">Propiedad de Datos</strong>
            <span class="metric-caption">Audiencias, cuentas y CRM a tu nombre</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problema vs Solución: Por Qué la Pauta B2B Tradicional Falla -->
  <section class="section compare-problem-section" id="problema">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">El Dilema Corporativo</span>
        <h2>¿Por Qué las Redes Sociales Convencionales No Te Traen Clientes de Alto Ticket?</h2>
        <p class="section-lead">
          En mis consultorías con empresas B2B y firmas de consultoría, veo a directores de marketing frustrados por invertir miles de dólares en plataformas masivas sin cerrar un solo contrato empresarial:
        </p>
      </div>

      <div class="grid grid-3 problem-cards-grid">
        <div class="card problem-card">
          <div class="problem-card-icon">🚫</div>
          <h3>Públicos Sin Poder de Decisión</h3>
          <p>En redes masivas pagas por impactos a practicantes, estudiantes o personas que buscan empleo. Tu equipo comercial pierde horas persiguiendo prospectos que no tienen presupuesto ni autorización de compra.</p>
        </div>

        <div class="card problem-card">
          <div class="problem-card-icon">💸</div>
          <h3>Campañas Optimizadas por Clics Baratos</h3>
          <p>Las agencias tradicionales te presumen un "Costo por Clic bajo" trayendo tráfico de curiosos, pero la tasa de cierre en ventas es cero. En B2B no necesitas 10,000 visitas baratas; necesitas 20 conversaciones con directores generales.</p>
        </div>

        <div class="card problem-card">
          <div class="problem-card-icon">⏳</div>
          <h3>Ciclos de Venta Rotos Sin Nutrición</h3>
          <p>Una venta corporativa tarda de 30 a 90 días en cerrarse. Enviar tráfico frío a una web genérica sin retargeting por cargo ni contenido de autoridad hace que el prospecto corporativo se olvide de ti al día siguiente.</p>
        </div>
      </div>

      <div class="solution-highlight-box card">
        <div class="solution-header">
          <span class="solution-badge">LA SOLUCIÓN</span>
          <h3>El Sistema de Prospección Directiva en LinkedIn Ads</h3>
        </div>
        <p>
          LinkedIn es la única base de datos empresarial del mundo que se actualiza en tiempo real por los propios usuarios. Estructuro un ecosistema donde segmentamos por <strong>cargo específico, industria vertical, tamaño de facturación y tecnología instalada</strong>. Combinamos formularios nativos de auto-relleno con secuencias de nutrición de autoridad para que tus ejecutivos comerciales solo tengan llamadas con prospectos que verdaderamente pueden contratar tu solución.
        </p>
      </div>
    </div>
  </section>

  <!-- 4 Frentes de Especialización en LinkedIn Ads -->
  <section class="section specialization-section" id="especializacion">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Metodología Comprobada</span>
        <h2>Los 4 Pilares de Mi Estrategia en LinkedIn Ads</h2>
        <p class="section-lead">Cada campaña se configura bajo un estándar riguroso para maximizar la calidad de los contactos y reducir el Costo por Adquisición:</p>
      </div>

      <div class="grid grid-2 spec-grid">
        <!-- Pilar 1 -->
        <div class="card spec-card">
          <div class="spec-card-header">
            <span class="spec-number">01</span>
            <h3>Account-Based Marketing (ABM) & Matched Audiences</h3>
          </div>
          <p class="spec-desc">
            Si tu equipo comercial tiene una lista de 200, 500 o 1,000 empresas objetivo que sueñas con cerrar, las convertimos en audiencias de pauta directa.
          </p>
          <ul class="spec-bullets">
            <li><strong>Carga de listas de cuentas (Company Match):</strong> Pauta exclusiva dirigida a las compañías que tú seleccionas.</li>
            <li><strong>Filtro cruzado por jerarquía:</strong> Mostramos anuncios únicamente a los cargos con poder de firma (C-Level, VP, Directores).</li>
            <li><strong>Exclusión de competidores y empleados propios:</strong> Ningún dólar se malgasta en ojos irrelevantes.</li>
          </ul>
        </div>

        <!-- Pilar 2 -->
        <div class="card spec-card">
          <div class="spec-card-header">
            <span class="spec-number">02</span>
            <h3>Lead Gen Forms Nativos con Cualificación Previa</h3>
          </div>
          <p class="spec-desc">
            Captamos la información verídica del profesional sin sacarlo de su flujo de trabajo habitual en LinkedIn.
          </p>
          <ul class="spec-bullets">
            <li><strong>Datos corporativos verificados:</strong> Correo de empresa, teléfono directo, cargo y nombre de la organización auto-rellenados.</li>
            <li><strong>Preguntas de filtro personalizadas:</strong> Agregamos campos como <em>"¿Cuál es el presupuesto anual para este proyecto?"</em> o <em>"¿Cuántos empleados tiene tu empresa?"</em>.</li>
            <li><strong>Tasa de conversión de 10% a 18%:</strong> Muy superior al 2% típico de las páginas de aterrizaje externas.</li>
          </ul>
        </div>

        <!-- Pilar 3 -->
        <div class="card spec-card">
          <div class="spec-card-header">
            <span class="spec-number">03</span>
            <h3>Contenido de Autoridad, Document Ads & Thought Leadership</h3>
          </div>
          <p class="spec-desc">
            En el sector corporativo, nadie compra sin percibir competencia técnica y solvencia estratégica demostrable.
          </p>
          <ul class="spec-bullets">
            <li><strong>Document Ads (PDFs y Whitepapers interactivos):</strong> Los prospectos hojean informes de la industria o casos de éxito sin salir de la plataforma.</li>
            <li><strong>Thought Leadership Ads:</strong> Promocionamos publicaciones directas del perfil de tu fundador o CEO para humanizar la marca.</li>
            <li><strong>Copywriting B2B persuasivo:</strong> Mensajes que atacan los dolores reales de la junta directiva: costos operativos, riesgos y eficiencia.</li>
          </ul>
        </div>

        <!-- Pilar 4 -->
        <div class="card spec-card">
          <div class="spec-card-header">
            <span class="spec-number">04</span>
            <h3>Retargeting B2B Multicanal & Sincronización con CRM</h3>
          </div>
          <p class="spec-desc">
            Cercamos digitalmente al comité evaluador durante todo su proceso de análisis y toma de decisiones.
          </p>
          <ul class="spec-bullets">
            <li><strong>LinkedIn Insight Tag + Conversiones CAPI:</strong> Medición milimétrica de descargas, vistas de vídeo y visitas a tu web.</li>
            <li><strong>Retargeting secuencial de 3 fases:</strong> Dolor inicial &rarr; Caso de éxito con cifras &rarr; Invitación a sesión de diagnóstico.</li>
            <li><strong>Integración en tiempo real con tu CRM:</strong> Los prospectos llegan en segundos a HubSpot, Salesforce, Zoho o Slack.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Entregables Concretos de la Gestión Mensual -->
  <section class="section deliverables-section" id="entregables">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Alcance del Servicio</span>
        <h2>¿Qué Incluye Mi Servicio Mensual de LinkedIn Ads?</h2>
        <p class="section-lead">Gestión estratégica y técnica integral para que tu equipo comercial se concentre únicamente en cerrar propuestas:</p>
      </div>

      <div class="grid grid-3 deliv-grid">
        <div class="card deliv-card">
          <div class="deliv-badge">FASE 1</div>
          <h3>Auditoría de ICP & Segmentación</h3>
          <p>Definimos con tu equipo el perfil de cliente ideal (ICP), industrias prioritarias, cargos exactos, exclusiones y listas de empresas estratégicas para pauta.</p>
          <ul class="deliv-bullets">
            <li>Mapeo de tomadores de decisión y comités de compra.</li>
            <li>Configuración o depuración de LinkedIn Campaign Manager.</li>
            <li>Instalación y verificación del LinkedIn Insight Tag.</li>
          </ul>
        </div>

        <div class="card deliv-card">
          <div class="deliv-badge">FASE 2</div>
          <h3>Diseño de Campañas & Lead Gen</h3>
          <p>Estructuración de anuncios con enfoque de solución ejecutiva y diseño de formularios nativos con preguntas de calificación.</p>
          <ul class="deliv-bullets">
            <li>Redacción de copys persuasivos B2B sin jerga vacía.</li>
            <li>Creación de creatividades estáticas y Document Ads.</li>
            <li>Conexión de formularios con CRM (HubSpot, Salesforce, etc.).</li>
          </ul>
        </div>

        <div class="card deliv-card">
          <div class="deliv-badge">FASE 3</div>
          <h3>Optimización Continua & Calibración</h3>
          <p>Monitoreo semanal del Costo por Lead (CPL), depuración demográfica de empresas impactadas y escalamiento de audiencias ganadoras.</p>
          <ul class="deliv-bullets">
            <li>Revisión del reporte demográfico de LinkedIn semanalmente.</li>
            <li>Ajuste de pujas manuales y automáticas por impresión/clic.</li>
            <li>Reunión mensual de balance comercial y optimización de pipeline.</li>
          </ul>
        </div>
      </div>

      <div class="text-center" style="margin-top: 2rem;">
        <a href="#formulario-contacto" class="btn btn-primary" id="linkedin-cta-deliverables-bottom">
          ⚡ Solicitar Cotización de este Servicio
        </a>
      </div>
    </div>
  </section>

  <!-- Calificación: Para Quién Es y Para Quién NO Es -->
  <section class="section qualification-section" id="criterio">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Filtro de Idoneidad</span>
        <h2>¿LinkedIn Ads es el Canal Adecuado para Tu Negocio?</h2>
        <p class="section-lead">
          LinkedIn Ads es una herramienta extraordinaria, pero no sirve para todo tipo de empresa. Trabajemos juntos si cumplimos estas condiciones:
        </p>
      </div>

      <div class="grid grid-2 qualification-grid">
        <div class="card qual-card qual-good">
          <h3 class="qual-title text-success">✓ Sí es para ti si:</h3>
          <ul class="qual-list">
            <li><strong>Vendes soluciones B2B o servicios corporativos:</strong> Software SaaS, consultoría financiera/legal, logística, ciberseguridad, maquinaria o servicios profesionales.</li>
            <li><strong>Tu ticket promedio o LTV supera los $1,500 USD:</strong> Si el cierre de un solo cliente te deja miles de dólares de margen, LinkedIn es el canal más rentable del mercado.</li>
            <li><strong>Tus clientes son directores o cargos ejecutivos específicos:</strong> Necesitas hablar con el Director de TI, la Gerente de RRHH o el CEO, no con el público general.</li>
            <li><strong>Tienes un equipo comercial activo que contacta leads rápido:</strong> Un lead de LinkedIn debe ser contactado en las primeras 2 a 4 horas para mantener la temperatura de compra.</li>
            <li><strong>Cuentas con presupuesto mensual de pauta de al menos $800 USD:</strong> Para competir con solvencia en la subasta profesional.</li>
          </ul>
        </div>

        <div class="card qual-card qual-bad">
          <h3 class="qual-title text-danger">✗ NO es para ti si:</h3>
          <ul class="qual-list">
            <li><strong>Vendes productos de consumo masivo o bajo ticket B2C:</strong> Para ropa, calzado o accesorios de $30 USD, Meta Ads y TikTok Ads son infinitamente más eficientes.</li>
            <li><strong>Tu presupuesto total mensual de pauta es menor a $500 USD:</strong> En LinkedIn los CPMs son más altos; con poco presupuesto no alcanzarás masa crítica de aprendizaje.</li>
            <li><strong>Buscas venta impulsiva sin ciclo de contacto:</strong> Las decisiones corporativas requieren confianza, reuniones de demostración y propuestas formales.</li>
            <li><strong>Nadie en tu empresa llama o responde a los prospectos:</strong> Si los leads se quedan acumulados en un Excel sin seguimiento, la inversión se perderá por completo.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabla Comparativa: Conmigo vs Agencia Tradicional vs Freelancer Genérico -->
  <section class="section comparison-table-section" id="comparativa">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Comparativa Directa</span>
        <h2>¿Por Qué Gestionar Tu LinkedIn Ads Conmigo?</h2>
      </div>

      <div class="comparison-table-wrapper card">
        <table class="brutalist-table">
          <thead>
            <tr>
              <th>Factor Clave</th>
              <th class="highlight-col">Conmigo (Especialista Senior B2B)</th>
              <th>Agencia Tradicional</th>
              <th>Freelancer Genérico</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Experiencia en B2B Real</strong></td>
              <td class="highlight-col"><strong>Más de 10 años especializándome en captación corporativa y ABM</strong></td>
              <td>Enfoque masivo B2C aplicado erróneamente a cuentas corporativas</td>
              <td>Conocimiento superficial de botones de pauta sin estrategia de negocio</td>
            </tr>
            <tr>
              <td><strong>Atención & Ejecución</strong></td>
              <td class="highlight-col"><strong>Directa 1 a 1 sin intermediarios ni analistas junior</strong></td>
              <td>Delegada a becarios o analistas que gestionan 30 clientes a la vez</td>
              <td>Disponibilidad inestable e informal</td>
            </tr>
            <tr>
              <td><strong>Calificación de Prospectos</strong></td>

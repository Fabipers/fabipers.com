---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm';

const title = "Especialista en Google Ads | Gestión Profesional de Campañas SEM y PMax (2027)";
const description = "Contrata a un especialista certificado como Google Partner. Diseño, optimizo y escalo campañas rentables en Google Search, Performance Max y Shopping con retorno medible.";
---

<Layout title={title} description={description}>
  <!-- Schema: Service & FAQPage JSON-LD -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "name": "Gestión y Administración de Google Ads",
          "serviceType": "Publicidad en Motores de Búsqueda (SEM)",
          "provider": {
            "@type": "Person",
            "name": "Fabián Pérez",
            "jobTitle": "Especialista Senior en Google Ads & Trafficker Digital",
            "url": "https://fabipers.com"
          },
          "areaServed": [
            { "@type": "Country", "name": "Colombia" },
            { "@type": "Country", "name": "Estados Unidos" }
          ],
          "description": "Servicio integral de gestión, optimización y auditoría de campañas de Google Ads (Búsqueda, Shopping, Performance Max y YouTube) para empresas de servicios y comercio electrónico."
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Cuánto presupuesto mínimo necesito para que Google Ads sea rentable?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Para el mercado en Colombia, recomiendo una inversión mínima en pauta de $2.000.000 a $3.500.000 COP al mes. Para Estados Unidos y Miami, un presupuesto mínimo de $1,000 a $2,500 USD al mes. Esta cifra garantiza que el algoritmo de Google complete la fase de aprendizaje y genere un flujo constante de clientes calificados."
              }
            },
            {
              "@type": "Question",
              "name": "¿En cuánto tiempo se empiezan a ver los resultados?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A diferencia del SEO orgánico, las campañas de Google Ads se activan de inmediato. Es habitual empezar a recibir clics calificados, llamadas y prospectos desde la primera semana. La estabilización óptima del Costo por Adquisición (CPA) y el ROAS se consolida entre las semanas 2 y 4 tras depurar términos negativos."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué incluye el servicio mensual de gestión de Google Ads?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Incluye auditoría previa, configuración técnica de conversiones (GA4, GTM y Consent Mode v2), estructuración de campañas por intención de compra, redacción persuasiva de anuncios, limpieza continua de palabras clave negativas, optimización de pujas Smart Bidding y dashboards en tiempo real."
              }
            },
            {
              "@type": "Question",
              "name": "¿Quién es el dueño de la cuenta publicitaria de Google Ads?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Tu empresa es la dueña del 100% de la cuenta publicitaria, el historial de datos y la facturación con Google. Yo ingreso como administrador técnico externo. Si decides terminar el servicio, todo tu historial y campañas permanecen intactos en tu propiedad."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué diferencia hay entre contratarte a ti y contratar a una agencia tradicional?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "En una agencia tradicional tu cuenta suele ser delegada a analistas junior que gestionan 30 a 50 clientes a la vez. Al trabajar conmigo tienes atención 1 a 1 de un especialista senior certificado como Google Partner con más de 10 años de experiencia, optimizaciones semanales profundas y comunicación directa sin intermediarios."
              }
            }
          ]
        }
      ]
    }
  </script>

  <!-- Hero Section con Formulario en Parte Superior Derecha -->
  <section class="section service-hero-detail" id="hero">
    <div class="container srv-hero-grid">
      <!-- Columna Izquierda: Mensaje Comercial y Autoridad -->
      <div class="srv-hero-content">
        <div class="badge-wrapper">
          <span class="hero-badge rotate-left">⚡ ESPECIALISTA CERTIFICADO GOOGLE PARTNER</span>
        </div>
        <h1 class="hero-title">
          Especialista en <span class="highlight-text">Google Ads</span>: Campañas de Alta Intención de Compra
        </h1>
        <p class="hero-subtitle">
          No tires tu presupuesto en clics basura. Como consultor senior certificado por Google, diseño, optimizo y administro campañas de <strong>Búsqueda, Performance Max y Shopping</strong> en Colombia y Miami orientadas a la captación directa de clientes y ventas medibles.
        </p>

        <!-- Puntos Fuertes en Viñetas Brutalistas -->
        <div class="hero-bullet-list">
          <div class="hero-bullet-item">
            <span class="bullet-icon">🎯</span>
            <div>
              <strong>Intención Transaccional Pura:</strong> Aparece frente a clientes que buscan comprar ahora mismo, no curiosos.
            </div>
          </div>
          <div class="hero-bullet-item">
            <span class="bullet-icon">🛡️</span>
            <div>
              <strong>Auditoría & Bloqueo de Negativas:</strong> Exclusión de búsquedas informacionales (*"gratis"*, *"empleo"*, *"pdf"*).
            </div>
          </div>
          <div class="hero-bullet-item">
            <span class="bullet-icon">📊</span>
            <div>
              <strong>Medición Server-Side y GA4:</strong> Seguimiento infalible de llamadas, formularios y WhatsApp.
            </div>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#formulario-contacto" class="btn btn-primary" id="google-cta-quote-top">
            ⚡ Cotizar Propuesta Gratuita
          </a>
          <a href="https://api.whatsapp.com/send?phone=+573182873558&text=Hola%20Fabi%C3%A1n,%20quiero%20cotizar%20la%20gesti%C3%B3n%20de%20mis%20campa%C3%B1as%20de%20Google%20Ads" class="btn btn-whatsapp" id="google-cta-whatsapp" target="_blank" rel="noopener noreferrer">
            💬 WhatsApp (+57 318 287 3558)
          </a>
          <a href="#entregables" class="btn btn-secondary" id="google-cta-deliverables">
            Ver Entregables &darr;
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Formulario de Contacto Superior -->
      <div class="srv-hero-form-col">
        <div class="google-partner-hero-bar">
          <div class="gp-bar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
          </div>
          <div class="gp-bar-text">
            <strong>Insignia Google Partner Oficial</strong>
            <span class="gp-subtle-sep">•</span>
            <span class="gp-subtle-desc">SEM & Machine Learning</span>
          </div>
        </div>

        <LeadForm 
          client:load 
          locationName="Colombia & Miami"
          formTitle="Cotiza tu Gestión de Google Ads"
          formSubtitle="Analizaré tu modelo de negocio o cuenta actual para diseñar una propuesta rentable en menos de 24h."
          tagText="⚡ PROPUESTA EN 24H"
          sourcePage="landing_servicio_google_ads"
          defaultService="Solo Google Ads (Search, Shopping, PMax, YouTube)"
        />
      </div>
    </div>
  </section>

  <!-- Barra de Autoridad y Métricas Clave -->
  <section class="section authority-metrics-bar">
    <div class="container">
      <div class="grid grid-4 metrics-grid">
        <div class="card metric-stat-card text-center">
          <span class="metric-number">10+ Años</span>
          <span class="metric-title">Experiencia Práctica</span>
          <p class="metric-caption">Especialista dedicado a pauta digital y analítica.</p>
        </div>
        <div class="card metric-stat-card text-center">
          <span class="metric-number">Google Partner</span>
          <span class="metric-title">Certificación Oficial</span>
          <p class="metric-caption">Acreditación directa en Búsqueda y PMax.</p>
        </div>
        <div class="card metric-stat-card text-center">
          <span class="metric-number">3.8x ROAS</span>
          <span class="metric-title">Retorno Promedio</span>
          <p class="metric-caption">En campañas optimizadas para conversión real.</p>
        </div>
        <div class="card metric-stat-card text-center">
          <span class="metric-number">100% Tuyo</span>
          <span class="metric-title">Propiedad de Datos</span>
          <p class="metric-caption">Cuentas, píxeles e historial siempre a tu nombre.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Problema vs Solución: Por Qué las Empresas Queman Dinero -->
  <section class="section compare-problem-section" id="problema">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Diagnóstico Comercial</span>
        <h2>¿Por Qué el 90% de las Empresas Queman su Dinero en Google Ads?</h2>
        <p class="section-lead">La mayoría de anunciantes culpan a la plataforma cuando el problema real está en la ejecución técnica y estratégica.</p>
      </div>

      <div class="grid grid-2 compare-grid">
        <!-- Tarjeta Problema -->
        <div class="card problem-brutalist-card">
          <div class="card-status-badge status-bad">❌ LA GESTIÓN TRADICIONAL</div>
          <h3>Cómo se Quema tu Presupuesto:</h3>
          <ul class="problem-list">
            <li><strong>Aceptar recomendaciones automáticas de Google:</strong> Configurar concordancias amplias sin control que solo aumentan el consumo de clics.</li>
            <li><strong>Cero palabras clave negativas:</strong> Pagar clics por términos como *"gratis"*, *"empleo"*, *"cursos"* o *"descargar PDF"*.</li>
            <li><strong>Medir solo visitas en vez de ventas:</strong> Configurar como conversión una simple visita a la página web en lugar de un lead real.</li>
            <li><strong>Delegación en juniors de agencia:</strong> Tu cuenta es administrada por pasantes que atienden 30 clientes simultáneamente.</li>
          </ul>
        </div>

        <!-- Tarjeta Solución -->
        <div class="card solution-brutalist-card">
          <div class="card-status-badge status-good">✅ MI ENFOQUE SENIOR</div>
          <h3>Cómo Hago Rentable tu Inversión:</h3>
          <ul class="solution-list">
            <li><strong>Estructura Transaccional de Alta Intención:</strong> Apareces únicamente cuando el usuario busca contratar o comprar tus servicios.</li>
            <li><strong>Filtro Semanal de Términos Negativos:</strong> Bloqueo proactivo de cualquier término no comercial para que cada peso rinda.</li>
            <li><strong>Infraestructura GA4 & GTM Server-Side:</strong> Medición exacta de llamadas telefónicas, clics de WhatsApp y formularios.</li>
            <li><strong>Atención 1 a 1 de un Especialista Senior:</strong> Optimizo tu cuenta semanalmente y reporto directamente sin intermediarios.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Entregables Técnicos del Servicio -->
  <section class="section deliverables-section" id="entregables">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Alcance del Trabajo</span>
        <h2>¿Qué Incluye Mi Servicio Mensual de Gestión de Google Ads?</h2>
        <p class="section-lead">Una metodología probada en más de una década para asegurar tracción continua y escalado predecible.</p>
      </div>

      <div class="grid grid-3 deliverables-grid">
        <div class="card deliverable-card">
          <div class="deliv-number">01</div>
          <h3>Auditoría & Setup Técnico</h3>
          <p>Instalación y verificación de conversiones en Google Tag Manager, GA4, Consent Mode v2 y Conversiones Mejoradas (*Enhanced Conversions*).</p>
          <ul class="deliv-bullets">
            <li>Auditoría de historial de cuenta</li>
            <li>Configuración de dataLayer</li>
            <li>Modelado de conversiones con IA</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <div class="deliv-number">02</div>
          <h3>Arquitectura de Búsqueda & PMax</h3>
          <p>Estructuración de grupos de anuncios estrechamente temáticos (STAGs) y campañas omnicanal de Performance Max con recursos de alta calidad.</p>
          <ul class="deliv-bullets">
            <li>Keyword research transaccional</li>
            <li>Redacción publicitaria persuasiva</li>
            <li>Extensiones de llamada y sitelinks</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <div class="deliv-number">03</div>
          <h3>Optimización Semanal de Pujas</h3>
          <p>Ajustes constantes de Smart Bidding (CPA Objetivo y ROAS Objetivo), depuración de términos de búsqueda y pruebas A/B de anuncios.</p>
          <ul class="deliv-bullets">
            <li>Limpieza de términos irrelevantes</li>
            <li>Control de presupuesto diario</li>
            <li>Incremento del Nivel de Calidad (QS)</li>
          </ul>
        </div>
      </div>

      <!-- Fila Inferior de Entregables -->
      <div class="grid grid-2 deliverables-bottom-grid">
        <div class="card deliverable-card">
          <div class="deliv-number">04</div>
          <h3>Auditoría de Landing Page & CRO</h3>
          <p>El anuncio atrae al usuario, pero la página web cierra la venta. Reviso la velocidad de carga móvil, fricción de formularios y coherencia de mensaje.</p>
        </div>
        <div class="card deliverable-card">
          <div class="deliv-number">05</div>
          <h3>Dashboard en Looker Studio & Reuniones</h3>
          <p>Acceso a un panel en tiempo real donde ves exactamente tu inversión, clics, prospectos, costo por lead y retorno neto, más sesión mensual de estrategia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtro de Calificación: Para Quién Es y Para Quién NO Es -->
  <section class="section qualification-section" id="calificacion">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Filtro de Transparencia</span>
        <h2>¿Este Servicio es Adecuado para Tu Empresa?</h2>
        <p class="section-lead">Trabajo con un cupo máximo de 5 a 8 cuentas activas para garantizar atención técnica profunda. Por eso es vital que estemos alineados.</p>
      </div>

      <div class="grid grid-2 qualification-grid">
        <div class="card qual-card qual-yes">
          <h3 class="qual-title text-success">✅ Este servicio ES para ti si:</h3>
          <ul class="qual-list">
            <li>Tienes un negocio de servicios, B2B o E-commerce con modelo de negocio validado y ticket promedio rentable.</li>
            <li>Cuentas con un presupuesto mensual de inversión en pauta de al menos <strong>$2.000.000 COP</strong> (Colombia) o <strong>$1,000 USD</strong> (Miami / USA).</li>
            <li>Buscas una relación estratégica con un especialista senior y no quieres que tu cuenta sea delegada a un practicante.</li>
            <li>Tienes un equipo o proceso comercial ágil para atender y cerrar los prospectos que lleguen por WhatsApp o formulario.</li>
          </ul>
        </div>

        <div class="card qual-card qual-no">
          <h3 class="qual-title text-danger">❌ Este servicio NO es para ti si:</h3>
          <ul class="qual-list">
            <li>Buscas "milagros" en 48 horas sin dar tiempo a que los algoritmos de Machine Learning completen su fase de aprendizaje (2 a 4 semanas).</li>
            <li>Tu producto o servicio no tiene demanda activa o intención de búsqueda demostrada en Google.</li>
            <li>Buscas el proveedor más barato del mercado que cobre $300.000 COP al mes por "poner anuncios automáticos".</li>
            <li>Tu sitio web tarda 10 segundos en cargar y no estás dispuesto a optimizar la experiencia de tu cliente.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabla Comparativa: Consultor Senior vs Agencia vs Junior -->
  <section class="section comparison-table-section" id="comparativa">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Toma de Decisiones</span>
        <h2>Comparativa: ¿Por Qué Elegir un Especialista Independiente?</h2>
      </div>

      <div class="card comparison-table-wrapper">
        <table class="brutalist-table">
          <thead>
            <tr>
              <th>Criterio</th>
              <th class="highlight-col">👨‍💻 Fabián Pérez (Senior)</th>
              <th>🏢 Agencia Tradicional</th>
              <th>👶 Freelancer Económico</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Atención & Comunicación</strong></td>
              <td class="highlight-col"><strong>Directa 1 a 1 por WhatsApp y llamadas</strong></td>
              <td>A través de ejecutivos de cuenta intermediarios</td>
              <td>Directa pero con disponibilidad errática</td>
            </tr>
            <tr>
              <td><strong>Carga de Cuentas</strong></td>
              <td class="highlight-col"><strong>Máximo 5 a 8 clientes simultáneos</strong></td>
              <td>25 a 40 cuentas por analista junior</td>
              <td>Indefinido / Volumen masivo</td>
            </tr>
            <tr>
              <td><strong>Profundidad de Tracking</strong></td>
              <td class="highlight-col"><strong>Avanzada: GTM, GA4, Server-Side y Consent Mode</strong></td>
              <td>Básica (solo etiquetas automáticas del panel)</td>
              <td>Mínima o inexistente</td>
            </tr>
            <tr>
              <td><strong>Propiedad de la Cuenta</strong></td>
              <td class="highlight-col"><strong>100% tuya desde el primer día</strong></td>
              <td>A veces retienen la cuenta o píxeles si te vas</td>
              <td>Suele ser propia</td>
            </tr>
            <tr>
              <td><strong>Optimización Continua</strong></td>
              <td class="highlight-col"><strong>Semanal (negativas, copys, Smart Bidding)</strong></td>
              <td>Quincenal o mensual</td>
              <td>"Crear y olvidar" hasta que el cliente reclama</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Intermedio -->
  <section class="section mid-cta-section">
    <div class="container">
      <div class="cta-banner-brutalist">
        <h2>¿Quieres saber qué potencial de ventas tiene tu sector en Google Ads?</h2>
        <p>Analicemos juntos los costos por clic, palabras clave de alta intención y competencia en Colombia o Miami.</p>
        <div class="cta-banner-actions">
          <a href="#hero" class="btn btn-primary" id="mid-cta-form">
            ⚡ Cotizar Campaña Arriba
          </a>
          <a href="https://api.whatsapp.com/send?phone=+573182873558&text=Hola%20Fabi%C3%A1n,%20quiero%20consultarte%20sobre%20mi%20cuenta%20de%20Google%20Ads" class="btn btn-whatsapp" id="mid-cta-whatsapp" target="_blank" rel="noopener noreferrer">
            💬 Preguntar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Recursos del Cluster de Google Ads (Interlinking de Autoridad) -->
  <section class="section cluster-resources-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Guías y Recursos Técnicos</span>
        <h2>Aprende Más Sobre Gestión Estratégica de Google Ads</h2>
        <p class="section-lead">Artículos en profundidad redactados desde mi experiencia práctica para que tomes decisiones informadas:</p>
      </div>

      <div class="grid grid-3 cluster-grid">
        <a href="/gestion-y-administracion-de-google-ads" class="card cluster-card">
          <span class="cluster-tag">GUÍA PILAR</span>
          <h3>Gestión de Google Ads: Estrategia y Tarifas (2027)</h3>
          <p>Descubre qué incluye una administración profesional, modelos de cobro y entregables clave.</p>
          <span class="read-more-link">Leer Guía Completa &rarr;</span>
        </a>

        <a href="/cuanto-invertir-en-google-ads-colombia-miami-2027" class="card cluster-card">
          <span class="cluster-tag">PRESUPUESTOS</span>
          <h3>¿Cuánto Invertir en Google Ads en Colombia y Miami?</h3>
          <p>Costos por clic reales (CPC) por sector y la fórmula matemática para calcular tu retorno proyectado.</p>
          <span class="read-more-link">Ver Tabla de Costos &rarr;</span>
        </a>

        <a href="/por-que-google-ads-no-convierte-auditoria-2027" class="card cluster-card">
          <span class="cluster-tag">AUDITORÍA</span>
          <h3>¿Por Qué Mis Anuncios Tienen Clics pero No Ventas?</h3>
          <p>Checklist de diagnóstico en 6 pasos para encontrar fugas de presupuesto y problemas de conversión.</p>
          <span class="read-more-link">Hacer Diagnóstico &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section Enriquecida -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Dudas Frecuentes</span>
        <h2>Preguntas Frecuentes sobre el Servicio de Google Ads</h2>
      </div>

      <div class="faq-wrap card">
        <div class="faq-item">
          <h4>¿Cuánto presupuesto mínimo necesito para que Google Ads sea rentable?</h4>
          <p>Para el mercado en Colombia, recomiendo una inversión mínima en pauta de $2.000.000 a $3.500.000 COP al mes. Para Estados Unidos y Miami, un presupuesto mínimo de $1,000 a $2,500 USD al mes. Esta cifra garantiza que el algoritmo de Google complete la fase de aprendizaje y genere un flujo constante de clientes calificados. Consulta más en nuestra <a href="/cuanto-invertir-en-google-ads-colombia-miami-2027" style="text-decoration: underline; font-weight: 700; color: inherit;">guía de presupuestos reales de Google Ads</a>.</p>
        </div>

        <div class="faq-item">
          <h4>¿En cuánto tiempo se empiezan a ver los resultados?</h4>
          <p>A diferencia del SEO orgánico, las campañas de Google Ads se activan de inmediato. Es habitual empezar a recibir clics calificados, llamadas y prospectos desde la primera semana. La estabilización óptima del Costo por Adquisición (CPA) y el ROAS se consolida entre las semanas 2 y 4 tras depurar términos negativos.</p>
        </div>

        <div class="faq-item">
          <h4>¿Qué incluye el servicio mensual de gestión de Google Ads?</h4>

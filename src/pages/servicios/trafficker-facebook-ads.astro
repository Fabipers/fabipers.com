---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm';

const title = "Trafficker Meta Ads (Facebook & Instagram) | Embudos y CAPI";
const description = "Especialista senior en Meta Ads (Facebook e Instagram Ads) en Colombia y Miami. Embudos de WhatsApp de alta conversión, e-commerce scaling y tracking con Meta CAPI.";
---

<Layout title={title} description={description} image="/images/og-meta-ads.png">
  <!-- Schema: Service & FAQPage JSON-LD -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Service",
          "name": "Gestión y Optimización de Meta Ads (Facebook e Instagram)",
          "serviceType": "Publicidad en Redes Sociales (Paid Social & Performance)",
          "provider": {
            "@type": "Person",
            "name": "Fabián Pérez",
            "jobTitle": "Especialista Senior en Meta Ads & Trafficker Digital",
            "url": "https://fabipers.com"
          },
          "areaServed": [
            { "@type": "Country", "name": "Colombia" },
            { "@type": "Country", "name": "Estados Unidos" }
          ],
          "description": "Servicio especializado de estructuración, optimización y escalamiento de campañas en Facebook e Instagram Ads con embudos de WhatsApp, comercio electrónico y tracking server-side (Meta CAPI)."
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Es mejor enviar el tráfico de Meta Ads a WhatsApp o a una página web?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Depende del modelo de venta y madurez de tu equipo comercial. Para servicios B2B, venta consultiva y productos de ticket medio-alto en Colombia y Latinoamérica, el embudo híbrido de WhatsApp (anuncio con filtro previo en landing page y botón directo a chat) genera las mayores tasas de conversión. Para tiendas online (E-commerce) con catálogo múltiple, el tráfico directo a páginas de producto optimizadas con catálogo dinámico y checkout rápido es el camino más escalable."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué es la API de Conversiones de Meta (CAPI) y por qué el Píxel ya no es suficiente?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "El Píxel tradicional se ejecuta en el navegador del usuario y hoy en día pierde entre un 30% y 40% de los datos debido a iOS (ATT), adblockers y restricciones de cookies de terceros. La Meta Conversions API (CAPI) envía los eventos directamente desde el servidor a los servidores de Meta, recuperando la atribución exacta, mejorando el Event Quality Score y permitiendo que el algoritmo aprenda con prospectos y compras reales."
              }
            },
            {
              "@type": "Question",
              "name": "¿En cuánto tiempo se estabilizan los resultados de una campaña en Meta Ads?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Meta Ads requiere aproximadamente 50 eventos de optimización por conjunto de anuncios en una ventana de 7 días para salir de la fase de aprendizaje. En mis implementaciones, los primeros prospectos comienzan a ingresar entre las primeras 48 y 72 horas, y la optimización de costo por adquisición (CPA) y escalamiento controlado se consolida entre las semanas 2 y 4 de gestión continua."
              }
            },
            {
              "@type": "Question",
              "name": "¿Quién se encarga del diseño de imágenes, videos y textos de los anuncios?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yo me encargo de toda la estrategia creativa: definición de ángulos de venta, hooks de 3 segundos para detener el scroll, y copywriting persuasivo con fórmulas probadas (PAS, AIDA). Si cuentas con diseñador interno o equipo audiovisual, les entrego los briefs exactos. Si no, estructuro plantillas visuales y adaptaciones de alto impacto directo."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cuánto presupuesto mensual debo invertir en anuncios de Facebook e Instagram?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Para empresas en Colombia, sugiero una inversión mínima de pauta de $1.500.000 a $3.000.000 COP al mes para garantizar masa crítica de datos. Para marcas que pautan en Miami o Estados Unidos, el presupuesto base recomendado ronda entre $1,000 y $3,000 USD mensuales. Esta inversión se abona directamente a Meta en tu propia tarjeta de crédito."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué diferencia hay entre trabajar contigo y contratar a una agencia tradicional de redes?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La mayoría de agencias asignan tu cuenta a analistas junior o practicantes que gestionan 30 clientes simultáneamente y se limitan a crear publicaciones y prender anuncios sin entender el margen de tu negocio. Al trabajar conmigo tienes comunicación directa 1 a 1 con un especialista senior con más de 10 años de experiencia técnica, enfocado obsesivamente en costo por lead calificado, ROAS y facturación neta."
              }
            }
          ]
        }
      ]
    }
  </script>

  <!-- Hero Section con Formulario en Parte Superior Derecha -->
  <section class="section service-hero-detail" id="hero">
    <div class="container srv-hero-grid">
      <!-- Columna Izquierda: Mensaje Comercial y Autoridad -->
      <div class="srv-hero-content">
        <div class="badge-wrapper">
          <span class="hero-badge rotate-left">⚡ ESPECIALISTA EN META ADS & WHATSAPP FUNNELS</span>
        </div>
        <h1 class="hero-title">
          Especialista en <span class="highlight-text">Meta Ads</span>: Embudos en Facebook & Instagram que Venden
        </h1>
        <p class="hero-subtitle">
          De nada sirve acumular clics o <em>likes</em> vacíos si no se traducen en facturación real. Como trafficker digital senior, diseño, audito y administro campañas de <strong>Facebook Ads, Instagram Ads y WhatsApp</strong> para empresas en Colombia y Miami respaldadas por medición Server-Side (Meta CAPI) y creativos persuasivos.
        </p>

        <!-- Puntos Fuertes en Viñetas Brutalistas -->
        <div class="hero-bullet-list">
          <div class="hero-bullet-item">
            <span class="bullet-icon">💬</span>
            <div>
              <strong>Embudos Híbridos a WhatsApp:</strong> Filtramos prospectos calificados antes del chat para evitar que tu equipo pierda el día respondiendo a curiosos sin presupuesto.
            </div>
          </div>
          <div class="hero-bullet-item">
            <span class="bullet-icon">🛒</span>
            <div>
              <strong>Escalamiento E-commerce & D2C:</strong> Campañas Advantage+ con catálogos dinámicos optimizadas al valor de compra (ROAS real sobre margen).
            </div>
          </div>
          <div class="hero-bullet-item">
            <span class="bullet-icon">🛡️</span>
            <div>
              <strong>Tracking Server-Side (Meta CAPI):</strong> Recuperación del 30% al 40% de conversiones que los navegadores e iOS bloquean por cookies de terceros.
            </div>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#formulario-contacto" class="btn btn-primary" id="meta-cta-quote-top">
            ⚡ Cotizar Propuesta Gratuita
          </a>
          <a href="https://api.whatsapp.com/send?phone=+573182873558&text=Hola%20Fabi%C3%A1n,%20quiero%20cotizar%20la%20gesti%C3%B3n%20de%20mis%20campa%C3%B1as%20de%20Meta%20Ads" class="btn btn-whatsapp" id="meta-cta-whatsapp" target="_blank" rel="noopener noreferrer">
            💬 WhatsApp (+57 318 287 3558)
          </a>
          <a href="#entregables" class="btn btn-secondary" id="meta-cta-deliverables">
            Ver Entregables &darr;
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Formulario de Contacto Superior -->
      <div class="srv-hero-form-col">
        <div class="google-partner-hero-bar">
          <div class="gp-bar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.772-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z" fill="#0081FB"/>
            </svg>
          </div>
          <div class="gp-bar-text">
            <strong>Especialista en Meta Ads & CAPI</strong>
            <span class="gp-subtle-sep">•</span>
            <span class="gp-subtle-desc">Funnels & Server-Side Tracking</span>
          </div>
        </div>

        <LeadForm 
          client:load 
          locationName="Colombia & Miami"
          formTitle="Cotiza tu Estrategia de Meta Ads"
          formSubtitle="Analizaré tu modelo de negocio, embudo actual o creativos para estructurar una propuesta rentable en menos de 24h."
          tagText="⚡ PROPUESTA EN 24H"
          sourcePage="landing_servicio_facebook_ads"
          defaultService="Solo Meta Ads (Facebook & Instagram)"
        />
      </div>
    </div>
  </section>

  <!-- Barra de Autoridad y Métricas Clave (Compacta) -->
  <section class="authority-metrics-bar">
    <div class="container">
      <div class="metrics-compact-grid">
        <div class="metric-compact-item">
          <span class="metric-number">10+ Años</span>
          <div class="metric-info">
            <strong class="metric-title">Experiencia Práctica</strong>
            <span class="metric-caption">Especialista en adquisición y analítica</span>
          </div>
        </div>
        <div class="metric-compact-item">
          <span class="metric-number">Meta CAPI</span>
          <div class="metric-info">
            <strong class="metric-title">100% Server-Side</strong>
            <span class="metric-caption">Tracking directo sin pérdida por cookies</span>
          </div>
        </div>
        <div class="metric-compact-item">
          <span class="metric-number">+280%</span>
          <div class="metric-info">
            <strong class="metric-title">Leads Cualificados</strong>
            <span class="metric-caption">Funnels de WhatsApp y landing pages</span>
          </div>
        </div>
        <div class="metric-compact-item">
          <span class="metric-number">100% Tuyo</span>
          <div class="metric-info">
            <strong class="metric-title">Propiedad de Datos</strong>
            <span class="metric-caption">Píxeles, catálogos y audiencias tuyas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problema vs Solución: Por Qué las Empresas Queman Dinero en Meta Ads -->
  <section class="section compare-problem-section" id="problema">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Diagnóstico Estratégico</span>
        <h2>¿Por Qué la Mayoría Quema su Presupuesto en Facebook e Instagram Ads?</h2>
        <p class="section-lead">
          En mis auditorías a cuentas publicitarias en Colombia y Estados Unidos, encuentro que el 85% de las empresas cometen los mismos 4 errores críticos que disparan el costo por lead y agotan el presupuesto sin generar ventas reales:
        </p>
      </div>

      <div class="grid grid-2 compare-grid">
        <!-- Tarjeta Problema -->
        <div class="card problem-brutalist-card">
          <div class="card-status-badge status-bad">❌ Lo Que Hace la Mayoría (Pérdida de Dinero)</div>
          <h3>El Enfoque Tradicional / Inexperto</h3>
          <ul class="problem-list">
            <li><strong>Usar el botón azul "Promocionar publicación":</strong> Quema el dinero inflando métricas de vanidad (likes y comentarios) sin registrar eventos de conversión comercial.</li>
            <li><strong>Mandar tráfico frío directo a WhatsApp sin filtro:</strong> Llena el WhatsApp de tu equipo con cientos de mensajes tipo <em>"precio?"</em> de personas que jamás comprarán.</li>
            <li><strong>Píxel ciego por bloqueos de iOS y Safari:</strong> Sin Meta Conversions API (CAPI), pierdes el 35% de los datos y el algoritmo de Meta se queda sin señales para optimizar.</li>
            <li><strong>Creativos estáticos y aburridos durante 6 meses:</strong> La audiencia se agota (ad fatigue), el CTR se desploma y el CPM sube exponencialmente.</li>
            <li><strong>Festejar clics baratos en lugar de ROAS neto:</strong> Reportes de agencias que muestran miles de clics pero la cuenta bancaria del negocio no sube.</li>
          </ul>
        </div>

        <!-- Tarjeta Solución -->
        <div class="card solution-brutalist-card">
          <div class="card-status-badge status-good">✓ Mi Metodología Senior (Conversión Real)</div>
          <h3>Estructura Estratégica con Meta CAPI</h3>
          <ul class="solution-list">
            <li><strong>Campañas en Business Manager con Objetivos Reales:</strong> Estructuras orientadas a eventos de conversión profunda (Compras, Leads Cualificados, Agendamientos).</li>
            <li><strong>Embudos Híbridos con Filtro Previo:</strong> Landing pages o formularios enriquecidos que califican presupuesto e interés antes de abrir la conversación por WhatsApp.</li>
            <li><strong>Tracking Server-Side con Meta CAPI y GTM:</strong> Registro íntegro de eventos sin depender de cookies, logrando un Event Quality Match superior al 8.5/10.</li>
            <li><strong>Laboratorio de Testing Creativo Continuo:</strong> Pruebas semanales de hooks visuales de 3 segundos, variaciones de copy (PAS, AIDA) y formatos Reels/Stories/Feed.</li>
            <li><strong>Optimización guiada por Rentabilidad y Margen:</strong> Foco absoluto en el Costo por Adquisición (CPA) y Retorno de la Inversión en Pauta (ROAS).</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mis 4 Frentes de Especialización en Meta Ads -->
  <section class="section frameworks-section" id="especialidades">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Soluciones de Alto Impacto</span>
        <h2>Mis 4 Frentes de Especialización en Meta Ads</h2>
        <p class="section-lead">
          No aplico fórmulas genéricas. Cada modelo de negocio requiere una arquitectura de pauta adaptada a su proceso de venta:
        </p>
      </div>

      <div class="grid grid-2 framework-grid">
        <div class="card framework-card">
          <div class="framework-icon-box">💬</div>
          <h3>1. Embudos Híbridos a WhatsApp (Servicios & B2B)</h3>
          <p>
            En Colombia y Latinoamérica, WhatsApp es el canal donde se cierran los negocios. Estructuro embudos con landing pages de filtro que educan al prospecto sobre tu propuesta de valor y precio antes de redirigirlo al chat con un mensaje automatizado y contextualizado.
          </p>
          <ul class="framework-bullets">
            <li>Filtro de curiosos mediante preguntas clave de presupuesto y necesidad.</li>
            <li>Disparo de evento server-side (`Lead`) únicamente cuando el usuario hace clic hacia WhatsApp.</li>
            <li>Capacitación rápida de guiones de respuesta comercial para tu equipo de ventas.</li>
          </ul>
        </div>

        <div class="card framework-card">
          <div class="framework-icon-box">🛒</div>
          <h3>2. Escalamiento para E-commerce (D2C & Retail)</h3>
          <p>
            Si vendes en Shopify, WooCommerce o VTEX, el objetivo es maximizar el ROAS sobre el margen bruto. Implemento campañas Advantage+ Shopping con catálogos dinámicos, retargeting de carritos abandonados y segmentación por valor de cliente recurrente (LTV).
          </p>
          <ul class="framework-bullets">
            <li>Configuración de eventos estándar (`AddToCart`, `InitiateCheckout`, `Purchase`) con CAPI.</li>
            <li>Estrategias de exclusión estricta de compradores recientes para evitar quemar pauta.</li>
            <li>Anuncios dinámicos que muestran el producto exacto que el usuario vio en tu tienda.</li>
          </ul>
        </div>

        <div class="card framework-card">
          <div class="framework-icon-box">📋</div>
          <h3>3. Generación de Leads de Alto Ticket (B2B & Consultoría)</h3>
          <p>
            Para servicios profesionales, inmobiliarias, clínicas, software o educación superior. Creamos formularios nativos instantáneos (Instant Forms) con preguntas de validación condicional y sincronización en tiempo real vía Webhook con tu CRM o correo.
          </p>
          <ul class="framework-bullets">
            <li>Preguntas de validación superior para eliminar datos de contacto falsos.</li>
            <li>Descargas de lead magnets o cotizadores interactivos como imán de captación.</li>
            <li>Puntuación y calificación automática de prospectos comerciales.</li>
          </ul>
        </div>

        <div class="card framework-card">
          <div class="framework-icon-box">🎨</div>
          <h3>4. Estrategia Creativa & Copywriting de Impacto</h3>
          <p>
            En el feed y reels de Instagram, el creativo es el 80% del éxito de la campaña. Diseño briefs estructurados para creativos UGC (User Generated Content), videos con hooks de 3 segundos que cortan el scroll y copys persuasivos centrados en los dolores reales de tu cliente.
          </p>
          <ul class="framework-bullets">
            <li>Pruebas de hooks (ganchos visuales) para elevar la tasa de retención del video.</li>
            <li>Copies estructurados con fórmulas de persuasión probadas (Problema-Agitación-Solución).</li>
            <li>Rotación metódica de formatos: Reels 9:16, carruseles de producto e imágenes estáticas con prueba social.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Entregables Concretos del Servicio Mensual -->
  <section class="section deliverables-section" id="entregables">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Claridad y Compromiso</span>
        <h2>¿Qué Incluye Exactamente Mi Gestión Mensual de Meta Ads?</h2>
        <p class="section-lead">
          Al contratar mi servicio no pagas por "hacer publicaciones", sino por una dirección técnica y estratégica continua orientada a rentabilidad:
        </p>
      </div>

      <div class="grid grid-3 deliverables-grid">
        <div class="card deliverable-card">
          <span class="deliv-number">01</span>
          <h3>Auditoría & Setup Técnico</h3>
          <p>Verificación de Business Manager, dominios, píxel de Meta, API de Conversiones (CAPI) y configuración en Google Tag Manager.</p>
          <ul class="deliv-bullets">
            <li>Diagnóstico profundo de cuenta publicitaria previa.</li>
            <li>Deduplicación de eventos Píxel + CAPI.</li>
            <li>Configuración de eventos agregados en Business Suite.</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <span class="deliv-number">02</span>
          <h3>Investigación de Audiencias & Oferta</h3>
          <p>Análisis de competidores, definición de ángulos comerciales de dolor/beneficio y estructuración de audiencias personalizadas.</p>
          <ul class="deliv-bullets">
            <li>Construcción de públicos similares (Lookalikes 1%-3%).</li>
            <li>Segmentación broad de alto volumen y Advantage+.</li>
            <li>Exclusión de clientes actuales y carritos ya comprados.</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <span class="deliv-number">03</span>
          <h3>Briefing Creativo & Copywriting</h3>
          <p>Redacción de textos persuasivos para los anuncios y directrices claras de diseño y video para detener el scroll en feed y reels.</p>
          <ul class="deliv-bullets">
            <li>Ganchos de 3 segundos probados en video.</li>
            <li>Copywriting enfocado a objeciones y prueba social.</li>
            <li>Adaptaciones en formatos 1:1, 9:16 y 4:5.</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <span class="deliv-number">04</span>
          <h3>Estructura de Campañas (Funnels)</h3>
          <p>Arquitectura organizada de prospección (tráfico frío), consideración (tráfico tibio) y retargeting agresivo de cierre.</p>
          <ul class="deliv-bullets">
            <li>Control riguroso de presupuestos a nivel de campaña (CBO/ABO).</li>
            <li>Evitamos la superposición de públicos y canibalización.</li>
            <li>Campañas específicas para WhatsApp o Landing Pages.</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <span class="deliv-number">05</span>
          <h3>Optimización Semanal Proactiva</h3>
          <p>Análisis periódico de métricas, apagado de anuncios perdedores, escalamiento vertical y horizontal de creativos ganadores.</p>
          <ul class="deliv-bullets">
            <li>Revisión de CPM, Hook Rate y Costo por Resultado.</li>
            <li>Escalamiento de presupuesto gradual para no resetear aprendizaje.</li>
            <li>Prevención activa de fatiga publicitaria.</li>
          </ul>
        </div>

        <div class="card deliverable-card">
          <span class="deliv-number">06</span>
          <h3>Dashboard en Vivo & Sesión Estratégica</h3>
          <p>Tablero en tiempo real en Looker Studio para consultar ventas, leads, inversión y ROAS cuando quieras, sin esperar al final del mes.</p>
          <ul class="deliv-bullets">
            <li>Reunión mensual 1 a 1 de revisión de resultados.</li>
            <li>Comunicación directa conmigo vía WhatsApp y llamadas.</li>
            <li>Transparencia 100%: cuentas y datos siempre a tu nombre.</li>
          </ul>
        </div>
      </div>

      <div class="text-center" style="margin-top: 2rem;">
        <a href="#formulario-contacto" class="btn btn-primary" id="meta-cta-deliverables-bottom">
          ⚡ Solicitar Cotización de este Servicio
        </a>
      </div>
    </div>
  </section>

  <!-- Calificación: Para Quién Es y Para Quién NO Es -->
  <section class="section qualification-section" id="criterio">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Filtro de Compatibilidad</span>
        <h2>¿Este Servicio es el Adecuado para Tu Negocio?</h2>
        <p class="section-lead">
          Para garantizar resultados excepcionales y retorno de inversión real, solo trabajo con proyectos que cumplan con criterios mínimos de viabilidad:
        </p>
      </div>

      <div class="grid grid-2 qualification-grid">
        <div class="card qual-card qual-good">
          <h3 class="qual-title text-success">✓ Sí es para ti si:</h3>
          <ul class="qual-list">
            <li><strong>Cuentas con un producto o servicio probado:</strong> Ya tienes clientes satisfechos y sabes qué problema resuelves en el mercado.</li>
            <li><strong>Dispones de un presupuesto de pauta realista:</strong> Mínimo $1.500.000 COP/mes (Colombia) o $1,000 USD/mes (Miami/USA) exclusivo para pauta en Meta.</li>
            <li><strong>Cuentas con un proceso comercial ágil:</strong> Tienes personal o capacidad para responder los leads de WhatsApp en minutos, no en días.</li>
            <li><strong>Comprendes que la pauta es una inversión, no un gasto:</strong> Buscas construir un canal recurrente de captación y ventas predecibles.</li>
            <li><strong>Valoras el trabajo técnico y la atención senior 1 a 1:</strong> Deseas un consultor que se involucre en los números y la estrategia de tu negocio.</li>
          </ul>
        </div>

        <div class="card qual-card qual-bad">
          <h3 class="qual-title text-danger">✗ NO es para ti si:</h3>
          <ul class="qual-list">
            <li><strong>Buscas fórmulas mágicas de enriquecimiento rápido:</strong> Las campañas requieren datos, optimización continua y un buen producto detrás.</li>
            <li><strong>Quieres un "Community Manager" para subir posts:</strong> Mi servicio es de tráfico pago, analítica y conversión, no de gestión orgánica de redes.</li>

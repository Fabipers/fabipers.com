---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm';

// SEO Title & Description
const title = "Trafficker Digital en Miami | Especialista en Google & Meta Ads";
const description = "Contrata un Trafficker Digital en Miami especializado en el mercado hispano y B2B de EE. UU. Campañas de alto retorno en Google, Meta y LinkedIn Ads.";
---

<Layout title={title} description={description}>
  <!-- Schema: ProfessionalService (Miami) JSON-LD -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Fabián Pérez - Digital Trafficker Miami",
      "image": "https://fabipers.com/og-image.jpg",
      "url": "https://fabipers.com/trafficker-digital-miami",
      "telephone": "+573182873558",
      "priceRange": "$$",
      "description": "Paid traffic specialist (Google Ads, Meta Ads) and advanced web analytics for scaling businesses in Miami and the United States Hispanic market.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Miami",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 25.7617,
        "longitude": -80.1918
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Miami Metropolitan Area"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Digital Advertising Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Ads Management" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Meta Ads Management" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Analytics & Tracking" } }
        ]
      },
      "sameAs": [
        "https://linkedin.com/in/fabian-perez-trafficker",
        "https://instagram.com/fabipers"
      ]
    }
  </script>
  <!-- Hero Section -->
  <section class="section hero-section" id="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="badge-wrapper">
          <span class="hero-badge rotate-left">⚡ Especialista en Ads & Traffic en Miami</span>
        </div>
        <h1 class="hero-title">
          Trafficker Digital en Miami para el <span class="highlight-text">Mercado Hispano</span> y B2B
        </h1>
        <p class="hero-subtitle">
          ¿Buscas un Trafficker Digital en Miami que eleve tu presencia en línea al siguiente nivel? Potencio tu marca y aumento tu visibilidad mediante campañas orientadas a resultados reales en Google Ads y Meta Ads.
        </p>
        <div class="hero-actions">
          <a href="https://api.whatsapp.com/send?phone=+573182873558&text=Hola%20Fabi%C3%A1n,%20quiero%20una%20asesor%C3%ADa%20para%20el%20mercado%20de%20Miami" class="btn btn-whatsapp" id="hero-cta-whatsapp" target="_blank" rel="noopener noreferrer">
            <span class="whatsapp-icon">💬</span> Hablemos por WhatsApp
          </a>
          <a href="#servicios" class="btn btn-secondary" id="hero-cta-services">
            Ver Servicios
          </a>
        </div>
      </div>
      
      <!-- Columna Derecha: Formulario con Insignia Sutil de Google Partner -->
      <div class="hero-form-wrapper">
        <div class="google-partner-hero-bar">
          <div class="gp-bar-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
          </div>
          <div class="gp-bar-text">
            <strong>Google Partner Certificado</strong>
            <span class="gp-subtle-sep">•</span>
            <span class="gp-subtle-desc">Paid Media & Tracking</span>
          </div>
        </div>

        <LeadForm 
          client:load 
          locationName="Miami"
          formTitle="Cotiza tu Estrategia en Miami"
          formSubtitle="Completa los datos de tu empresa para recibir una propuesta adaptada al mercado estadounidense."
          tagText="⚡ COTIZACIÓN EN 24H"
          sourcePage="landing_miami"
        />
      </div>
    </div>
  </section>

  <!-- Problem vs Solution (Brutalist blocks) -->
  <section class="section compare-section" id="compare">
    <div class="container">
      <div class="grid grid-2">
        <div class="card problem-card">
          <span class="card-tag rotate-left">El Problema</span>
          <h2>¿Tus anuncios gastan dinero sin generar clientes?</h2>
          <p>La mayoría de los negocios en Miami compiten en un mercado saturado pagando costes por clic altísimos, sin una estrategia de conversión clara. Esto resulta en presupuestos quemados y anuncios ignorados.</p>
        </div>
        <div class="card solution-card">
          <span class="card-tag rotate-right highlight-box">La Solución</span>
          <h2>Embudo y segmentación de alta precisión</h2>
          <p>Estructuro tus campañas con un enfoque analítico estricto. Optimizamos la segmentación local en el área metropolitana de Miami y afinamos los mensajes para convertir los clics en llamadas y ventas reales.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section services-section" id="servicios">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Servicios Destacados</span>
        <h2>Estrategias hechas para facturar más</h2>
      </div>

      <div class="grid grid-3">
        <div class="card service-card">
          <div class="service-icon">📈</div>
          <h3>Paid Ads & Traffic</h3>
          <p>Gestión avanzada de Google Ads y Meta Ads (Facebook e Instagram). Segmentación hiperlocal enfocada en conversiones directas.</p>
        </div>

        <div class="card service-card">
          <div class="service-icon">🔍</div>
          <h3>SEO & Posicionamiento</h3>
          <p>Optimizo tu visibilidad orgánica para que tus clientes locales en Miami te encuentren a ti antes que a tu competencia.</p>
        </div>

        <div class="card service-card">
          <div class="service-icon">⚙️</div>
          <h3>Marketing Automation</h3>
          <p>Automatización de flujos de trabajo e integración de herramientas de analítica web para optimizar tus procesos comerciales.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works (Miami specific content) -->
  <section class="section steps-section" id="steps">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle">Metodología de Trabajo</span>
        <h2>Simplemente seguiremos estos 4 sencillos pasos</h2>
      </div>
      
      <div class="grid grid-2 step-grid">
        <div class="card step-card">
          <div class="step-number rotate-left">01</div>
          <h3>Análisis Estratégico</h3>
          <p>Nos sumergimos en el corazón de tu negocio. A través de entrevistas, análisis de mercado y evaluación de competidores, obtenemos una comprensión profunda de tus metas, valores y desafíos únicos para tu audiencia en Miami.</p>
        </div>
        
        <div class="card step-card">
          <div class="step-number rotate-right">02</div>
          <h3>Planificación Personalizada</h3>
          <p>Diseñamos una estrategia digital detallada y a medida. Desde la optimización de tu sitio web hasta la gestión de campañas publicitarias, cada aspecto está planificado para maximizar tu visibilidad local.</p>
        </div>
        
        <div class="card step-card">
          <div class="step-number rotate-left">03</div>
          <h3>Implementación Eficaz</h3>
          <p>Ponemos manos a la obra. Nuestro equipo se encarga de implementar cada aspecto de la estrategia de manera eficiente y efectiva, asegurando que cada paso se realice con excelencia.</p>
        </div>
        
        <div class="card step-card">
          <div class="step-number rotate-right">04</div>
          <h3>Optimización Continua</h3>
          <p>El éxito digital se trata de adaptarse. Monitoreamos el rendimiento, analizamos los datos en tiempo real y realizamos ajustes estratégicos continuos para garantizar el éxito de tu negocio en Miami.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Miami (FAQ / Copy Section) -->
  <section class="section why-miami-section" id="why-miami">
    <div class="container">
      <div class="card miami-card">
        <span class="highlight-box rotate-left">¿Por qué en Miami?</span>
        <h2>¿Por qué contratar a un Trafficker Digital en Miami?</h2>
        <p>Contratar un Trafficker Digital en Miami es fundamental para maximizar el potencial de tu negocio en el mercado local y más allá. Miami es una ciudad vibrante y diversa, con un mercado en constante evolución y una competencia cada vez mayor en el ámbito digital. Un Trafficker Digital local comprende las complejidades únicas de este mercado, desde las preferencias culturales hasta los comportamientos de búsqueda en línea.</p>
        <p>Con mi experiencia y conocimiento del mercado de Florida, puedo desarrollar estrategias personalizadas que te ayuden a destacar entre la multitud y atraer a tu audiencia de manera efectiva, impulsando el crecimiento y el retorno de inversión (ROI) a largo plazo.</p>
        <div style="margin-top: 2rem;">
          <a href="https://api.whatsapp.com/send?phone=+573182873558&text=Quiero%20una%20asesor%C3%ADa%20en%20Miami" class="btn btn-primary" id="miami-section-cta" target="_blank" rel="noopener noreferrer">
            Comenzar mi Análisis Gratuito
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    padding: 6.5rem 0 4rem 0;
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: flex-start;
  }
  
  @media (min-width: 992px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }
  
  .badge-wrapper {
    margin-bottom: 1.5rem;
  }
  
  .hero-badge {
    background-color: var(--text-primary);
    color: var(--accent-primary);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 1rem;
    border: 2px solid var(--border-color);
    display: inline-block;
  }
  
  .hero-title {
    font-size: clamp(2.3rem, 4.5vw, 3.6rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    font-weight: 900;
  }
  
  .highlight-text {
    background-color: var(--accent-primary);
    color: #ffffff;
    padding: 0 0.5rem;
    border: 3px solid var(--border-color);
    box-shadow: 3px 3px 0px var(--border-color);
    display: inline-block;
    transform: rotate(-0.5deg);
    margin-top: 0.2rem;
  }
  
  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
    font-weight: 500;
  }
  
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  
  .whatsapp-icon {
    font-size: 1.2rem;
  }
  
  /* Hero Form Wrapper & Subtle Google Partner Bar */
  .hero-form-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .google-partner-hero-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #ffffff;
    border: 3px solid var(--border-color);
    box-shadow: 4px 4px 0px var(--border-color);
    padding: 0.6rem 1rem;
    margin-bottom: 1rem;
    font-family: var(--font-heading);
    max-width: 100%;
  }

  .gp-bar-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .gp-bar-text {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .gp-bar-text strong {
    font-weight: 900;
    color: var(--text-primary);
  }

  .gp-bar-text .gp-subtle-sep {
    color: var(--text-muted);
  }

  .gp-bar-text .gp-subtle-desc {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.8rem;
  }

  /* Lead Form Card Inside Page */
  :global(.lead-form-card) {
    background-color: #ffffff;
    border: 4px solid var(--border-color);
    box-shadow: 8px 8px 0px var(--border-color);
    padding: 2.2rem;
    position: relative;
    width: 100%;
  }

  @media (max-width: 640px) {
    :global(.lead-form-card) {
      padding: 1.5rem;
      box-shadow: 5px 5px 0px var(--border-color);
    }
  }

  :global(.lead-form-header) {
    margin-bottom: 1.5rem;
  }

  :global(.lead-form-tag) {
    display: inline-block;
    background-color: var(--accent-primary);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 900;
    padding: 0.25rem 0.6rem;
    border: 2px solid var(--border-color);
    box-shadow: 2px 2px 0px var(--border-color);
    margin-bottom: 0.75rem;
  }

  :global(.lead-form-title) {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
  }

  :global(.lead-form-subtitle) {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  :global(.lead-form-body) {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.form-row-2) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    :global(.form-row-2) {
      grid-template-columns: 1fr 1fr;
    }
  }

  :global(.form-label) {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  :global(.req) {
    color: #e11d48;
  }

  :global(.form-input),
  :global(.form-select) {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    border: 3px solid var(--border-color);
    background-color: #ffffff;
    color: var(--text-primary);
    box-shadow: 2px 2px 0px var(--border-color);
    outline: none;
    transition: all var(--transition-fast);
  }

  :global(.form-input:focus),
  :global(.form-select:focus) {
    border-color: var(--accent-primary);
    box-shadow: 4px 4px 0px var(--accent-primary);
  }

  :global(.lead-submit-btn) {
    margin-top: 0.5rem;
    padding: 0.95rem 1.5rem;
    font-size: 1rem;
    cursor: pointer;
  }

  :global(.form-privacy-note) {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.25rem;
  }

  :global(.lead-form-error) {
    background-color: #fee2e2;
    color: #991b1b;
    border: 2px solid #ef4444;
    padding: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  :global(.lead-form-success) {
    text-align: center;
    padding: 1.5rem 0.5rem;
  }

  :global(.success-icon) {
    font-size: 2.8rem;
    margin-bottom: 0.5rem;
  }

  :global(.success-title) {
    font-size: 1.35rem;
    font-weight: 900;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  :global(.success-text) {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  
  /* Problem vs Solution */
  .compare-section {
    background-color: var(--bg-secondary);
    border-top: 3px solid var(--border-color);
    border-bottom: 3px solid var(--border-color);
  }
  
  .card-tag {
    position: absolute;
    top: -1.2rem;
    left: 1.5rem;
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    padding: 0.2rem 0.8rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  
  .problem-card {
    border-color: var(--border-color);
  }
  
  .solution-card {
    background-color: var(--bg-primary);
  }
  
  .compare-section h2 {
    font-size: 1.6rem;
    margin-top: 0.5rem;
    margin-bottom: 1.2rem;
  }
  
  .compare-section p {
    color: var(--text-secondary);
    font-weight: 500;
  }
  
  /* Services */
  .services-section {
    background-color: var(--bg-primary);
  }
  
  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1.2rem;
  }
  
  .service-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.8rem;
    font-weight: 800;
  }
  
  .service-card p {
    color: var(--text-secondary);
    font-weight: 500;
  }
  
  /* Steps */
  .steps-section {
    background-color: var(--bg-secondary);
    border-top: 3px solid var(--border-color);
    border-bottom: 3px solid var(--border-color);
  }
  
  .step-subtitle {
    color: var(--text-muted);
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 800;
    font-size: 0.9rem;
    display: block;
    margin-bottom: 0.6rem;
  }
  
  .step-number {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.8rem;
    color: #000000;
    background-color: var(--accent-primary);
    padding: 0.2rem 0.8rem;
    border: 3px solid var(--border-color);
    box-shadow: 2px 2px 0px var(--border-color);
    margin-bottom: 1.5rem;
  }
  
  .step-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.8rem;
    font-weight: 800;
  }
  
  .step-card p {
    color: var(--text-secondary);
    font-weight: 500;
  }
  
  /* Why Miami */
  .miami-card {
    padding: 4rem;
    background-color: var(--bg-primary);
  }
  
  .miami-card h2 {
    font-size: 2rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    font-weight: 900;
  }
  
  .miami-card p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  /* Clean Google Partner Chip */
  .google-partner-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #ffffff;
    color: #09090b;
    border: 2px solid #09090b;
    box-shadow: 2px 2px 0px #09090b;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>

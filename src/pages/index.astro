---
import Layout from '../layouts/Layout.astro';
import LeadMagnet from '../components/LeadMagnet';

// SEO Title & Description
const title = "Fabipers | Trafficker Digital Colombia & Full Stack Marketer";
const description = "Impulsa tus ventas con un Trafficker Digital experto. Estrategias de pauta en Google Ads y Meta Ads diseñadas para escalar la facturación de tu negocio.";
---

<Layout title={title} description={description}>
  <!-- 1. Hero Section (Above the Fold) -->
  <section class="hero-section">
    <div class="container hero-grid">
      <!-- Columna Izquierda (Textos) -->
      <div class="hero-left">
        <div class="badge-tag">
          ⚡ FABIÁN PÉREZ
        </div>
        
        <h1 class="hero-h1">
          Trafficker Digital para negocios que están <span class="highlight-magenta-span">cansados de quemar dinero</span> en Ads.
        </h1>
        
        <p class="hero-subtitle-p">
          No hago "anuncios bonitos". Construyo ecosistemas de adquisición B2B y E-commerce con Server-Side Tracking, automatización y embudos de alta conversión en Google y Meta Ads.
        </p>
        
        <a href="/servicios" class="btn-hero-cta" id="hero-main-cta">
          <span>CALCULA EL PRESUPUESTO DE TU ESTRATEGIA</span>
          <span class="cta-arrow">➔</span>
        </a>
        
        <p class="trust-note-text">
          🔒 Arquitectura basada en datos exactos. Sin presupuestos al azar.
        </p>
      </div>

      <!-- Columna Derecha (Calculadora Interactiva de Fuga de Presupuesto) -->
      <div class="hero-right">
        <div class="calc-card-brutalist">
          <h3 class="calc-card-title">Calculadora de Fuga</h3>
          <p class="calc-card-desc">
            Descubre cuánto presupuesto pierdes al mes por tener el Píxel desactualizado y sin Server-Side Tracking (Aprox. 30%).
          </p>
          
          <div class="calc-inputs-space">
            <div class="slider-group">
              <label class="slider-label">
                <span>Inversión Mensual (USD)</span>
                <span id="val-inversion" class="slider-val-highlight">$1,000</span>
              </label>
              <input type="range" id="slider-inversion" min="100" max="10000" step="100" value="1000" class="custom-range-input">
            </div>

            <div class="slider-group">
              <label class="slider-label">
                <span>CPA Promedio (USD)</span>
                <span id="val-cpa" class="slider-val-highlight">$10</span>
              </label>
              <input type="range" id="slider-cpa" min="1" max="100" step="1" value="10" class="custom-range-input">
            </div>

            <div class="calc-results-box">
              <p class="calc-results-sub">Dinero Quemado</p>
              <p id="calc-fuga" class="calc-fuga-amount">-$300<span class="per-month-text">/mes</span></p>
              <p class="calc-equiv-text">
                Equivale a <span id="calc-ventas" class="sales-lost-pill">30</span> ventas perdidas.
              </p>
            </div>

            <a href="/servicios" class="btn-stop-fuga">
              DETENER FUGA HOY
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NUEVA SECCIÓN: Densidad SEO de la Keyword -->
  <section class="section seo-authority-section">
    <div class="container">
      <div class="section-intro-header text-center">
        <span class="badge-tag dark-tag">SEO & ESTRATEGIA</span>
        <h2 class="section-h2">
          ¿Por qué tu negocio necesita un Trafficker Digital y no una agencia tradicional?
        </h2>
        <p class="section-lead-p">
          Un trafficker digital no hace "posts bonitos" ni persigue likes. Como trafficker digital experto, mi único objetivo es diseñar sistemas de compra de tráfico que conviertan clics en facturación real y medible.
        </p>
      </div>

      <div class="grid-3-cards">
        <!-- Tarjeta 1 -->
        <div class="card neo-card">
          <div class="badge-tag magenta-tag">Pilar #1</div>
          <h3>Compra de Tráfico Estratégico</h3>
          <p>
            Gestiono y escalo tu presupuesto en Meta Ads y Google Ads analizando datos para lograr el CPA más bajo del mercado.
          </p>
        </div>

        <!-- Tarjeta 2 -->
        <div class="card neo-card">
          <div class="badge-tag dark-tag">Pilar #2</div>
          <h3>Tracking y Analítica Avanzada</h3>
          <p>
            Implemento Server-Side Tracking, GA4 y GTM para que el algoritmo publicitario reciba información perfecta, incluso sin cookies.
          </p>
        </div>

        <!-- Tarjeta 3 -->
        <div class="card neo-card">
          <div class="badge-tag magenta-tag">Pilar #3</div>
          <h3>Optimización de Embudos (CRO)</h3>
          <p>
            Audito y ajusto técnicamente tus landing pages para asegurar que cada dólar invertido en publicidad retorne con alta conversión.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Barra de Autoridad Tecnológica -->
  <section class="tech-bar-strip">
    <div class="container text-center">
      <span class="tech-strip-label">TECNOLOGÍAS QUE USAMOS PARA BLINDAR TU TRACKING:</span>
      <div class="tech-badges-row">
        {[
          "Google Analytics 4",
          "Google Tag Manager",
          "Meta Conversions API",
          "Astro",
          "Node.js"
        ].map((tech) => (
          <div class="tech-chip">⚡ {tech}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Problema / Solución (Grid de 3 columnas) -->
  <section class="section problem-section">
    <div class="container">
      <div class="section-intro-header text-center">
        <span class="badge-tag magenta-tag">Diagnóstico Técnico</span>
        <h2 class="section-h2">¿Estás quemando dinero en tráfico que no convierte?</h2>
      </div>

      <div class="grid-3-cards">
        <!-- Error 1 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="badge-tag magenta-tag">Error #1</div>
            <h3>El Píxel Ciego</h3>
            <p>
              Con las nuevas políticas de privacidad, pierdes hasta el 40% de las ventas. Implemento Server-Side Tracking para que el algoritmo siempre sepa quién te compra.
            </p>
          </div>
          <div class="card-footer-tag">⚡ Solución: Meta CAPI + GTM Server</div>
        </div>

        <!-- Error 2 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="badge-tag dark-tag">Error #2</div>
            <h3>Landings Lentas</h3>
            <p>
              Si tu web tarda 5 segundos en cargar, ya perdiste al prospecto. Desarrollo páginas de aterrizaje ultra-rápidas enfocadas 100% en disparar tu tasa de conversión.
            </p>
          </div>
          <div class="card-footer-tag">⚡ Solución: Astro + CRO de alta velocidad</div>
        </div>

        <!-- Error 3 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="badge-tag magenta-tag">Error #3</div>
            <h3>Leads de Baja Calidad</h3>
            <p>
              Dejamos de rogar por clics. Conectamos tus campañas a embudos automatizados que filtran a los curiosos y te entregan prospectos listos para cerrar.
            </p>
          </div>
          <div class="card-footer-tag">⚡ Solución: Funnels B2B & Webhooks</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Captación TOFU (Lead Magnet Limpio) -->
  <section class="section tofu-lead-section">
    <div class="container max-w-tofu">
      <!-- Componente interactivo React LeadMagnet -->
      <LeadMagnet client:visible />
    </div>
  </section>

  <!-- 6. Servicios BOFU -->
  <section class="section bofu-services-section">
    <div class="container">
      <div class="section-intro-header text-center">
        <span class="badge-tag dark-tag">Servicios Especializados</span>
        <h2 class="section-h2">Ecosistemas de Crecimiento Digital</h2>
      </div>

      <div class="grid-3-cards">
        <!-- Servicio 1 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="service-emoji">🎯</div>
            <h3>Google Ads & Meta Ads</h3>
            <p>
              Campañas de búsqueda de alta intención y pauta disruptiva en redes sociales. Diseñadas para capturar clientes calificados con el menor costo por adquisición.
            </p>
          </div>
          <div class="service-links-box flex-column">
            <a href="/servicios/trafficker-google-ads">Google Ads &rarr;</a>
            <a href="/servicios/trafficker-facebook-ads">Meta Ads & Instagram &rarr;</a>
          </div>
        </div>

        <!-- Servicio 2 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="service-emoji">📊</div>
            <h3>Analítica Web Avanzada</h3>
            <p>
              Auditoría e implementación de GTM, GA4 y flujos de datos del servidor (Server-Side Tracking). Medición matemática exacta sin discrepancias de conversión.
            </p>
          </div>
          <div class="service-links-box">
            <a href="/servicios/analitica-web-tracking">Analítica & Tracking &rarr;</a>
          </div>
        </div>

        <!-- Servicio 3 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="service-emoji">⚙️</div>
            <h3>Automatización y Desarrollo</h3>
            <p>
              Integración de webhooks, CRMs y optimización técnica de tu sitio web mediante Landing Pages CRO ultra-rápidas construidas para convertir visitantes en ventas.
            </p>
          </div>
          <div class="service-links-box">
            <a href="/servicios/cro-landing-pages">Landing Pages & CRO &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Cierre Final (Pre-Footer) -->
  <section class="section final-callout-section text-center">
    <div class="container">
      <h2 class="final-cta-h2">
        Es hora de dejar de adivinar y empezar a medir.
      </h2>
      
      <div class="cta-center-align">
        <a href="/servicios" class="btn-hero-cta big-btn" id="home-bottom-cta">
          <span>COTIZAR MI ESTRATEGIA AHORA</span>
          <span class="cta-arrow">➔</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- Script para la Calculadora Interactiva de Fuga -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var sliderInversion = document.getElementById('slider-inversion');
    var sliderCpa = document.getElementById('slider-cpa');
    var valInversion = document.getElementById('val-inversion');
    var valCpa = document.getElementById('val-cpa');
    var calcFuga = document.getElementById('calc-fuga');
    var calcVentas = document.getElementById('calc-ventas');

    function calculate() {
      if (!sliderInversion || !sliderCpa || !valInversion || !valCpa || !calcFuga || !calcVentas) return;
      
      var inversion = parseFloat(sliderInversion.value);
      var cpa = parseFloat(sliderCpa.value);

      valInversion.textContent = '$' + inversion.toLocaleString('en-US');
      valCpa.textContent = '$' + cpa.toLocaleString('en-US');

      var fuga = Math.round(inversion * 0.30);
      var ventasPerdidas = Math.floor(fuga / cpa);

      calcFuga.innerHTML = '-$' + fuga.toLocaleString('en-US') + '<span style="font-size: 1.1rem; color: #09090b; font-weight: 700;">/mes</span>';
      calcVentas.textContent = ventasPerdidas.toString();
    }

    if (sliderInversion && sliderCpa) {
      sliderInversion.addEventListener('input', calculate);
      sliderCpa.addEventListener('input', calculate);
      calculate();
    }
  });
</script>

<style>
  /* Base Container & Grid System */
  .container {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;

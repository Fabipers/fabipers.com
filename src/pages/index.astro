---
import Layout from '../layouts/Layout.astro';
import LeadMagnet from '../components/LeadMagnet';

// SEO Title & Description
const title = "Fabipers | Trafficker Digital Colombia & Full Stack Marketer";
const description = "Impulsa tus ventas con un Trafficker Digital experto. Estrategias de pauta en Google Ads y Meta Ads diseñadas para escalar la facturación de tu negocio.";
---

<Layout title={title} description={description}>
  <!-- 1. Hero Section (Above the Fold) -->
  <section class="py-12 md:py-20 bg-white border-b-[4px] border-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Columna Izquierda (Textos & CTA) -->
        <div>
          <div class="inline-block bg-black text-white font-extrabold text-xs tracking-wider uppercase px-3 py-1.5 border-[3px] border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-6">
            ⚡ FABIÁN PÉREZ
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-black leading-tight text-balance mb-6">
            Trafficker Digital para negocios que están <span class="inline-block bg-[#f43f5e] text-white px-2 py-0.5 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] -rotate-1">cansados de quemar dinero</span> en Ads.
          </h1>
          
          <p class="mt-6 text-lg md:text-xl text-gray-800 font-medium leading-relaxed mb-8">
            No hago "anuncios bonitos". Construyo ecosistemas de adquisición B2B y E-commerce con Server-Side Tracking, automatización y embudos de alta conversión en Google y Meta Ads.
          </p>
          
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a 
              href="/servicios" 
              class="w-fit inline-flex items-center gap-2 bg-[#f43f5e] text-white font-black text-lg md:text-xl uppercase px-8 py-4 border-[4px] border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-[6px] active:translate-y-[6px] active:shadow-none transition-all text-center" 
              id="hero-main-cta"
            >
              <span>CALCULA EL PRESUPUESTO DE TU ESTRATEGIA</span>
              <span>➔</span>
            </a>
          </div>
          
          <p class="text-xs sm:text-sm font-bold text-gray-600 mt-4 flex items-center gap-1.5">
            🔒 Arquitectura basada en datos exactos. Sin presupuestos al azar.
          </p>
        </div>

        <!-- Columna Derecha (Gráfico Dinámico Animado) -->
        <div>
          <div class="relative w-full max-w-sm mx-auto aspect-square bg-white border-[4px] border-black shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] flex items-end p-6 gap-4 mt-8 md:mt-0">
            <div class="absolute -top-5 -right-5 bg-[#f43f5e] text-black font-extrabold text-xl px-4 py-2 border-[4px] border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] animate-[bounce_3s_infinite]">ROI +340%</div>
            <div class="w-full bg-gray-100 border-[4px] border-black h-[40%] animate-[pulse_2s_ease-in-out_infinite]"></div>
            <div class="w-full bg-black h-[60%] animate-[pulse_3s_ease-in-out_infinite_0.5s]"></div>
            <div class="w-full bg-[#f43f5e] border-[4px] border-black h-[85%] relative overflow-hidden">
              <div class="absolute bottom-0 left-0 w-full bg-white/30 animate-[bounce_4s_infinite]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NUEVA SECCIÓN: ¿Qué hace un Trafficker Digital Experto? -->
  <section class="py-16 md:py-24 bg-white border-b-[4px] border-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
        <span class="inline-block bg-black text-white font-extrabold text-xs uppercase px-3 py-1.5 border-[2px] border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-4">
          SEO & ESTRATEGIA
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-black leading-tight mb-4">
          ¿Por qué tu negocio necesita un Trafficker Digital y no una agencia de vanidad?
        </h2>
        <p class="text-base md:text-lg font-medium text-gray-800 leading-relaxed">
          Un trafficker digital no hace "posts bonitos" ni persigue likes. Como trafficker digital experto, mi único objetivo es diseñar sistemas de compra de tráfico que conviertan clics en facturación real y medible.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Tarjeta 1 -->
        <div class="bg-white border-[4px] border-black p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="bg-[#f43f5e] text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
              Pilar #1
            </div>
            <h3 class="text-xl font-black text-black mb-3">
              Compra de Tráfico Estratégico
            </h3>
            <p class="text-sm font-medium text-gray-700 leading-relaxed">
              Gestiono y escalo tu presupuesto en Meta Ads y Google Ads aplicando segmentación avanzada. Un trafficker digital analiza los datos para encontrar el costo por adquisición (CPA) más bajo del mercado.
            </p>
          </div>
        </div>

        <!-- Tarjeta 2 -->
        <div class="bg-white border-[4px] border-black p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="bg-black text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
              Pilar #2
            </div>
            <h3 class="text-xl font-black text-black mb-3">
              Tracking y Analítica Avanzada
            </h3>
            <p class="text-sm font-medium text-gray-700 leading-relaxed">
              El corazón de mis servicios de trafficker digital. Implemento Server-Side Tracking y flujos de datos con GA4 y GTM para que el algoritmo publicitario reciba información perfecta, incluso sin cookies.
            </p>
          </div>
        </div>

        <!-- Tarjeta 3 -->
        <div class="bg-white border-[4px] border-black p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="bg-[#f43f5e] text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
              Pilar #3
            </div>
            <h3 class="text-xl font-black text-black mb-3">
              Optimización de Embudos (CRO)
            </h3>
            <p class="text-sm font-medium text-gray-700 leading-relaxed">
              El tráfico no sirve si la página no convierte. Como full-stack marketer y trafficker digital, audito y ajusto técnicamente tus landing pages para asegurar que cada dólar invertido retorne con ganancia.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Barra de Autoridad Tecnológica -->
  <section class="py-8 bg-zinc-100 border-b-[4px] border-black">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <span class="block text-xs font-black uppercase tracking-widest text-zinc-500 mb-4">
        TECNOLOGÍAS QUE USAMOS PARA BLINDAR TU TRACKING:
      </span>
      <div class="flex flex-wrap justify-center items-center gap-3 sm:gap-4 md:gap-6">
        {[
          "Google Analytics 4",
          "Google Tag Manager",
          "Meta Conversions API",
          "Astro",
          "Node.js"
        ].map((tech) => (
          <div class="bg-white text-black font-black text-xs sm:text-sm uppercase px-4 py-2.5 border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            ⚡ {tech}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Problema / Solución (Grid de 3 columnas) -->
  <section class="py-16 md:py-24 bg-white border-b-[4px] border-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
        <span class="inline-block bg-[#f43f5e] text-white font-extrabold text-xs uppercase px-3 py-1 border-[2px] border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-4">
          Diagnóstico Técnico
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase text-black leading-tight">
          ¿Estás quemando dinero en tráfico que no convierte?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Caja 1 -->
        <div class="bg-white border-[4px] border-black p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="bg-[#f43f5e] text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
              Error #1
            </div>
            <h3 class="text-xl font-black uppercase text-black mb-3">
              El Píxel Ciego
            </h3>
            <p class="text-sm font-medium text-zinc-700 leading-relaxed">
              Con las nuevas políticas de privacidad, el píxel tradicional pierde hasta el 40% de las ventas. Implemento Server-Side Tracking para que el algoritmo siempre sepa quién te compra.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t-[2px] border-zinc-200 text-xs font-bold text-black uppercase">
            ⚡ Solución: Meta CAPI + GTM Server
          </div>
        </div>

        <!-- Caja 2 -->
        <div class="bg-white border-[4px] border-black p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="bg-black text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
              Error #2
            </div>
            <h3 class="text-xl font-black uppercase text-black mb-3">
              Landings Lentas
            </h3>
            <p class="text-sm font-medium text-zinc-700 leading-relaxed">
              Si tu web tarda 5 segundos en cargar, ya perdiste al prospecto. Desarrollo páginas de aterrizaje ultra-rápidas enfocadas 100% en disparar tu tasa de conversión.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t-[2px] border-zinc-200 text-xs font-bold text-black uppercase">
            ⚡ Solución: Astro + CRO de alta velocidad
          </div>
        </div>

        <!-- Caja 3 -->
        <div class="bg-white border-[4px] border-black p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="bg-[#f43f5e] text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4">
              Error #3
            </div>
            <h3 class="text-xl font-black uppercase text-black mb-3">
              Leads de Baja Calidad
            </h3>
            <p class="text-sm font-medium text-zinc-700 leading-relaxed">
              Dejamos de rogar por clics. Conectamos tus campañas a embudos automatizados que filtran a los curiosos y te entregan prospectos listos para cerrar.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t-[2px] border-zinc-200 text-xs font-bold text-black uppercase">
            ⚡ Solución: Funnels B2B & Webhooks
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Captación TOFU (Lead Magnet) -->
  <section class="py-16 md:py-20 bg-zinc-900 border-b-[4px] border-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-[#f43f5e] border-[4px] border-black p-8 md:p-12 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] text-white">
        <div class="inline-block bg-black text-white font-black text-xs uppercase px-3 py-1 border-[2px] border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-4">
          🎁 Recursos Gratuitos
        </div>
        
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase text-white leading-tight mb-4 drop-shadow-[2px_2px_0px_rgba(0,0,0,1)]">
          ¿Aún no estás listo para escalar? Empieza cerrando la fuga de dinero.
        </h2>
        
        <p class="text-base md:text-lg font-bold text-white mb-6 leading-relaxed">
          Descarga gratis el <span class="bg-black text-yellow-300 px-2 py-0.5 border-[2px] border-black inline-block">Checklist de Auditoría: Los 5 Errores Ocultos en tus Campañas de Ads</span> y aprende los ajustes técnicos para detener la fuga hoy mismo.
        </p>

        <!-- Interactive Lead Magnet Form Component -->
        <LeadMagnet client:visible />
      </div>
    </div>
  </section>

  <!-- 6. Servicios BOFU -->
  <section class="py-16 md:py-24 bg-white border-b-[4px] border-black">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
        <span class="inline-block bg-black text-white font-extrabold text-xs uppercase px-3 py-1 border-[2px] border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] mb-4">
          Servicios Especializados
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase text-black leading-tight">
          Ecosistemas de Crecimiento Digital
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Ítem 1 -->
        <div class="bg-white border-[4px] border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4">🎯</div>
            <h3 class="text-xl font-black uppercase text-black mb-3">
              Google Ads & Meta Ads
            </h3>
            <p class="text-sm font-medium text-zinc-700 leading-relaxed mb-6">
              Campañas de búsqueda de alta intención y pauta disruptiva en redes sociales. Diseñadas para capturar clientes calificados con el menor costo por adquisición.
            </p>
          </div>
          <div class="flex flex-col gap-2">
            <a href="/servicios/trafficker-google-ads" class="text-xs font-black uppercase text-[#f43f5e] hover:underline flex items-center gap-1">
              Google Ads →
            </a>
            <a href="/servicios/trafficker-facebook-ads" class="text-xs font-black uppercase text-[#f43f5e] hover:underline flex items-center gap-1">
              Meta Ads & Instagram →
            </a>
          </div>
        </div>

        <!-- Ítem 2 -->
        <div class="bg-white border-[4px] border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4">📊</div>
            <h3 class="text-xl font-black uppercase text-black mb-3">
              Analítica Web Avanzada
            </h3>
            <p class="text-sm font-medium text-zinc-700 leading-relaxed mb-6">
              Auditoría e implementación de GTM, GA4 y flujos de datos del servidor (Server-Side Tracking). Medición matemática exacta sin discrepancias de conversión.
            </p>
          </div>
          <a href="/servicios/analitica-web-tracking" class="text-xs font-black uppercase text-[#f43f5e] hover:underline flex items-center gap-1">
            Analítica & Tracking →
          </a>
        </div>

        <!-- Ítem 3 -->
        <div class="bg-white border-[4px] border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4">⚙️</div>
            <h3 class="text-xl font-black uppercase text-black mb-3">
              Automatización y Desarrollo
            </h3>
            <p class="text-sm font-medium text-zinc-700 leading-relaxed mb-6">
              Integración de webhooks, CRMs y optimización técnica de tu sitio web mediante Landing Pages CRO ultra-rápidas construidas para convertir visitantes en ventas.
            </p>
          </div>
          <a href="/servicios/cro-landing-pages" class="text-xs font-black uppercase text-[#f43f5e] hover:underline flex items-center gap-1">
            Landing Pages & CRO →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Cierre Final (Pre-Footer) -->
  <section class="py-16 md:py-24 bg-zinc-100 border-b-[4px] border-black text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase text-black leading-tight tracking-tight mb-8">
        Es hora de dejar de adivinar y empezar a medir.
      </h2>
      
      <div class="flex justify-center mt-8">
        <a 
          href="/servicios" 
          class="w-fit inline-flex items-center gap-2 bg-[#f43f5e] text-white font-black text-lg md:text-2xl uppercase px-8 sm:px-12 py-5 border-[4px] border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-x-[8px] active:translate-y-[8px] active:shadow-none transition-all text-center" 
          id="home-bottom-cta"
        >
          <span>COTIZAR MI ESTRATEGIA AHORA</span>
          <span>➔</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

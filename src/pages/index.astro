---
import Layout from '../layouts/Layout.astro';
import LeadMagnet from '../components/LeadMagnet';

// SEO Title & Description
const title = "Fabipers | Trafficker Digital Colombia & Full Stack Marketer";
const description = "Impulsa tus ventas con un Trafficker Digital experto. Estrategias de pauta en Google Ads y Meta Ads diseñadas para escalar la facturación de tu negocio.";
---

<Layout title={title} description={description}>
  <!-- 1. Hero Section (Above the Fold) -->
  <section class="section hero-section-v2">
    <div class="container hero-grid-v2">
      <!-- Columna Izquierda (Textos & CTA) -->
      <div class="hero-left-col">
        <div class="badge-tag-brutalist">
          ⚡ FABIÁN PÉREZ
        </div>
        
        <h1 class="hero-title-v2">
          Trafficker Digital para negocios que están <span class="highlight-magenta">cansados de quemar dinero</span> en Ads.
        </h1>
        
        <h2 class="hero-subtitle-v2">
          No hago "anuncios bonitos". Construyo ecosistemas de adquisición B2B y E-commerce con Server-Side Tracking, automatización y embudos de alta conversión en Google y Meta Ads.
        </h2>
        
        <div class="hero-cta-wrap">
          <a href="/servicios" class="btn-brutalist-cta" id="hero-main-cta">
            CALCULA EL PRESUPUESTO DE TU ESTRATEGIA ➔
          </a>
        </div>
        
        <p class="trust-microtext">
          🔒 Arquitectura basada en datos exactos. Sin presupuestos al azar.
        </p>
      </div>

      <!-- Columna Derecha (Gráfico Dinámico) -->
      <div class="hero-right-col">
        <div class="chart-box-brutalist">
          <div class="roi-badge-floating">ROI +340%</div>
          <div class="bar-col bar-1"></div>
          <div class="bar-col bar-2"></div>
          <div class="bar-col bar-3">
            <div class="bar-overlay"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Barra de Autoridad Tecnológica -->
  <section class="tech-bar-section">
    <div class="container text-center">
      <span class="tech-bar-label">
        TECNOLOGÍAS QUE USAMOS PARA BLINDAR TU TRACKING:
      </span>
      <div class="tech-tags-grid">
        {[
          "Google Analytics 4",
          "Google Tag Manager",
          "Meta Conversions API",
          "Astro",
          "Node.js"
        ].map((tech) => (
          <div class="tech-tag-card">
            ⚡ {tech}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Problema / Solución (Grid de 3 columnas) -->
  <section class="section problem-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle highlight-box">Diagnóstico Técnico</span>
        <h2>¿Estás quemando dinero en tráfico que no convierte?</h2>
      </div>

      <div class="grid-3-col">
        <!-- Caja 1 -->
        <div class="card problem-card">
          <div class="problem-badge">Error #1</div>
          <h3>El Píxel Ciego</h3>
          <p>
            Con las nuevas políticas de privacidad, el píxel tradicional pierde hasta el 40% de las ventas. Implemento Server-Side Tracking para que el algoritmo siempre sepa quién te compra.
          </p>
          <div class="solution-tag">⚡ Solución: Meta CAPI + GTM Server</div>
        </div>

        <!-- Caja 2 -->
        <div class="card problem-card">
          <div class="problem-badge dark-badge">Error #2</div>
          <h3>Landings Lentas</h3>
          <p>
            Si tu web tarda 5 segundos en cargar, ya perdiste al prospecto. Desarrollo páginas de aterrizaje ultra-rápidas enfocadas 100% en disparar tu tasa de conversión.
          </p>
          <div class="solution-tag">⚡ Solución: Astro + CRO de alta velocidad</div>
        </div>

        <!-- Caja 3 -->
        <div class="card problem-card">
          <div class="problem-badge">Error #3</div>
          <h3>Leads de Baja Calidad</h3>
          <p>
            Dejamos de rogar por clics. Conectamos tus campañas a embudos automatizados que filtran a los curiosos y te entregan prospectos listos para cerrar.
          </p>
          <div class="solution-tag">⚡ Solución: Funnels B2B & Webhooks</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Captación TOFU (Lead Magnet) -->
  <section class="section tofu-section">
    <div class="container">
      <div class="tofu-card-banner">
        <div class="tofu-tag">🎁 Recursos Gratuitos</div>
        
        <h2>
          ¿Aún no estás listo para escalar? Empieza cerrando la fuga de dinero.
        </h2>
        
        <p class="tofu-desc">
          Descarga gratis el <strong>Checklist de Auditoría: Los 5 Errores Ocultos en tus Campañas de Ads</strong> y aprende los ajustes técnicos para detener la fuga hoy mismo.
        </p>

        <!-- Componente interactivo React LeadMagnet -->
        <LeadMagnet client:visible />
      </div>
    </div>
  </section>

  <!-- 5. Servicios BOFU -->
  <section class="section bofu-services-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="step-subtitle highlight-box">Servicios Especializados</span>
        <h2>Ecosistemas de Crecimiento Digital</h2>
      </div>

      <div class="grid-3-col">
        <!-- Ítem 1 -->
        <div class="card service-bofu-card">
          <div class="service-icon">🎯</div>
          <h3>Google Ads & Meta Ads</h3>
          <p>
            Campañas de búsqueda de alta intención y pauta disruptiva en redes sociales. Diseñadas para capturar clientes calificados con el menor costo por adquisición.
          </p>
          <div class="service-links flex-col">
            <a href="/servicios/trafficker-google-ads">Google Ads &rarr;</a>
            <a href="/servicios/trafficker-facebook-ads">Meta Ads & Instagram &rarr;</a>
          </div>
        </div>

        <!-- Ítem 2 -->
        <div class="card service-bofu-card">
          <div class="service-icon">📊</div>
          <h3>Analítica Web Avanzada</h3>
          <p>
            Auditoría e implementación de GTM, GA4 y flujos de datos del servidor (Server-Side Tracking). Medición matemática exacta sin discrepancias de conversión.
          </p>
          <div class="service-links">
            <a href="/servicios/analitica-web-tracking">Analítica & Tracking &rarr;</a>
          </div>
        </div>

        <!-- Ítem 3 -->
        <div class="card service-bofu-card">
          <div class="service-icon">⚙️</div>
          <h3>Automatización y Desarrollo</h3>
          <p>
            Integración de webhooks, CRMs y optimización técnica de tu sitio web mediante Landing Pages CRO ultra-rápidas construidas para convertir visitantes en ventas.
          </p>
          <div class="service-links">
            <a href="/servicios/cro-landing-pages">Landing Pages & CRO &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Cierre Final (Pre-Footer) -->
  <section class="section final-cta-section">
    <div class="container text-center">
      <h2 class="final-cta-title">
        Es hora de dejar de adivinar y empezar a medir.
      </h2>
      
      <div class="hero-cta-wrap center-wrap">
        <a href="/servicios" class="btn-brutalist-cta big-btn" id="home-bottom-cta">
          COTIZAR MI ESTRATEGIA AHORA ➔
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section Grid */
  .hero-section-v2 {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background-color: var(--bg-primary);
    border-bottom: 3px solid var(--border-color);
  }

  .hero-grid-v2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid-v2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .badge-tag-brutalist {
    display: inline-block;
    background-color: #09090b;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border: 3px solid #09090b;
    box-shadow: 3px 3px 0px #09090b;
    margin-bottom: 1.5rem;
  }

  .hero-title-v2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .highlight-magenta {
    background-color: var(--accent-primary);
    color: #ffffff;
    padding: 0.1rem 0.4rem;
    border: 3px solid #09090b;
    box-shadow: 4px 4px 0px #09090b;
    display: inline-block;
  }

  .hero-subtitle-v2 {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 700;
    color: #3f3f46;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-cta-wrap {
    margin-bottom: 1rem;
  }

  .hero-cta-wrap.center-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-brutalist-cta {
    display: inline-block;
    background-color: var(--accent-primary);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1rem, 2vw, 1.25rem);
    text-transform: uppercase;
    padding: 1.1rem 2rem;
    border: 4px solid #09090b;
    box-shadow: 6px 6px 0px #09090b;
    text-decoration: none;
    line-height: 1.3;
    max-width: 100%;
    white-space: normal;
    text-align: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-brutalist-cta:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0px #09090b;
    color: #ffffff;
  }

  .btn-brutalist-cta:active {
    transform: translate(6px, 6px);
    box-shadow: 0px 0px 0px #09090b;
  }

  .btn-brutalist-cta.big-btn {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    padding: 1.25rem 2.5rem;
    box-shadow: 8px 8px 0px #09090b;
  }

  .trust-microtext {
    font-size: 0.85rem;
    font-weight: 700;
    color: #71717a;
    margin-top: 0.75rem;
  }

  /* Right Graphic Box */
  .hero-right-col {
    display: flex;
    justify-content: center;
  }

  .chart-box-brutalist {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    background-color: #ffffff;
    border: 4px solid #09090b;
    box-shadow: 10px 10px 0px #09090b;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    gap: 1rem;
    margin: 1rem 0;
  }

  .roi-badge-floating {
    position: absolute;
    top: -20px;
    right: -20px;
    background-color: var(--accent-primary);
    color: #ffffff;
    font-weight: 900;
    font-size: 1.15rem;
    padding: 0.5rem 1rem;
    border: 4px solid #09090b;
    box-shadow: 5px 5px 0px #09090b;
    animation: bounce 3s infinite;
  }

  .bar-col {
    width: 100%;
    border: 4px solid #09090b;
  }

  .bar-1 {
    background-color: #f1f5f9;
    height: 40%;
    animation: pulse 2s ease-in-out infinite;
  }

  .bar-2 {
    background-color: #09090b;
    height: 60%;
    animation: pulse 3s ease-in-out infinite 0.5s;
  }

  .bar-3 {
    background-color: var(--accent-primary);
    height: 85%;
    position: relative;
    overflow: hidden;
  }

  .bar-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.3);
    animation: bounce 4s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  /* Tech Bar */
  .tech-bar-section {
    padding: 2.5rem 0;
    background-color: var(--bg-tertiary);
    border-bottom: 3px solid var(--border-color);
  }

  .tech-bar-label {
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #71717a;
    margin-bottom: 1.25rem;
    display: block;
  }

  .tech-tags-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .tech-tag-card {
    background-color: #ffffff;
    color: #09090b;
    font-weight: 900;
    font-size: 0.85rem;
    text-transform: uppercase;
    padding: 0.6rem 1.1rem;
    border: 3px solid #09090b;
    box-shadow: 3px 3px 0px #09090b;
  }

  /* Problem / Solution Grid */
  .problem-section {
    padding: 5rem 0;
    border-bottom: 3px solid var(--border-color);
  }

  .grid-3-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .problem-card {
    background-color: #ffffff;
    border: 3px solid #09090b;
    box-shadow: 6px 6px 0px #09090b;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .problem-badge {
    display: inline-block;
    background-color: var(--accent-primary);
    color: #ffffff;
    font-weight: 900;
    font-size: 0.75rem;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border: 2px solid #09090b;
    box-shadow: 2px 2px 0px #09090b;
    margin-bottom: 1rem;
    width: fit-content;
  }

  .problem-badge.dark-badge {
    background-color: #09090b;
  }

  .problem-card h3 {
    font-size: 1.35rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    margin-bottom: 0.75rem;
  }

  .problem-card p {
    font-size: 0.95rem;
    color: #3f3f46;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .solution-tag {
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    padding-top: 1rem;
    border-top: 2px dashed #e4e4e7;
  }

  /* TOFU Lead Magnet Section */
  .tofu-section {
    padding: 4rem 0;
    background-color: #09090b;
    border-bottom: 3px solid var(--border-color);
  }

  .tofu-card-banner {
    background-color: var(--accent-primary);
    border: 4px solid #09090b;
    box-shadow: 8px 8px 0px #09090b;
    padding: 2.5rem 2rem;
    color: #ffffff;
  }

  .tofu-tag {
    display: inline-block;
    background-color: #09090b;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.8rem;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border: 2px solid #09090b;
    box-shadow: 2px 2px 0px #09090b;
    margin-bottom: 1.25rem;
  }

  .tofu-card-banner h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.3rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .tofu-desc {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* BOFU Services */
  .bofu-services-section {
    padding: 5rem 0;
    border-bottom: 3px solid var(--border-color);
  }

  .service-bofu-card {
    background-color: #ffffff;
    border: 3px solid #09090b;
    box-shadow: 6px 6px 0px #09090b;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .service-bofu-card h3 {
    font-size: 1.35rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    margin-bottom: 0.75rem;
  }

  .service-bofu-card p {
    font-size: 0.95rem;
    color: #3f3f46;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .service-links {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 2px dashed #e4e4e7;
  }

  .service-links.flex-col {
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-links a {
    font-size: 0.85rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--accent-primary);
    text-decoration: none;
  }

  .service-links a:hover {
    text-decoration: underline;
  }

  /* Final CTA */
  .final-cta-section {
    padding: 6rem 0;
    background-color: var(--bg-tertiary);
    border-bottom: 3px solid var(--border-color);
  }

  .final-cta-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    line-height: 1.15;
    max-width: 800px;
    margin: 0 auto;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import LeadMagnet from '../components/LeadMagnet';

// SEO Title & Description
const title = "Fabipers | Trafficker Digital Colombia & Full Stack Marketer";
const description = "Impulsa tus ventas con un Trafficker Digital experto. Estrategias de pauta en Google Ads y Meta Ads diseñadas para escalar la facturación de tu negocio.";
---

<Layout title={title} description={description}>
  <!-- 1. Hero Section (Above the Fold) -->
  <section class="hero-section">
    <div class="container hero-grid">
      <!-- Columna Izquierda (Textos & CTA) -->
      <div class="hero-left-col">
        <div class="badge-tag">
          ⚡ FABIÁN PÉREZ
        </div>
        
        <h1 class="hero-main-title">
          Trafficker Digital para negocios que están <span class="highlight-magenta-box">cansados de quemar dinero</span> en Ads.
        </h1>
        
        <p class="hero-description">
          No hago "anuncios bonitos". Construyo ecosistemas de adquisición B2B y E-commerce con Server-Side Tracking, automatización y embudos de alta conversión en Google y Meta Ads.
        </p>
        
        <div class="hero-cta-box">
          <a href="/servicios" class="btn-brutalist-hero" id="hero-main-cta">
            CALCULA EL PRESUPUESTO DE TU ESTRATEGIA ➔
          </a>
          <p class="trust-micro-note">
            🔒 Arquitectura basada en datos exactos. Sin presupuestos al azar.
          </p>
        </div>
      </div>

      <!-- Columna Derecha (Terminal Interactiva) -->
      <div class="hero-right-col">
        <div class="terminal-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="terminal-title">bash - root@fabipers:~</span>
          </div>

          <div class="terminal-body" id="diagnostic-form">
            <div class="terminal-question" data-question="1">
              <p class="prompt-text">> Ejecutando escaneo: ¿Usas Server-Side Tracking (CAPI)?</p>
              <div class="btn-group">
                <button type="button" class="answer-btn" data-val="yes">Sí</button>
                <button type="button" class="answer-btn" data-val="no">No / No sé</button>
              </div>
            </div>

            <div class="terminal-question" data-question="2">
              <p class="prompt-text">> Ping al servidor: ¿Tu web carga en menos de 3 segundos?</p>
              <div class="btn-group">
                <button type="button" class="answer-btn" data-val="yes">Sí</button>
                <button type="button" class="answer-btn" data-val="no">No / No sé</button>
              </div>
            </div>

            <div class="terminal-question" data-question="3">
              <p class="prompt-text">> Leyendo Datalayer: ¿Mides el valor exacto de compra en GA4?</p>
              <div class="btn-group">
                <button type="button" class="answer-btn" data-val="yes">Sí</button>
                <button type="button" class="answer-btn" data-val="no">No / No sé</button>
              </div>
            </div>

            <div id="terminal-result" class="terminal-result-box hidden"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SECCIÓN SEO: ¿Qué hace un Trafficker Digital Experto? -->
  <section class="section seo-authority-section">
    <div class="container">
      <div class="section-intro-header text-center">
        <span class="badge-tag dark-tag">SEO & ESTRATEGIA</span>
        <h2 class="section-h2">
          ¿Por qué tu negocio necesita un Trafficker Digital y no una agencia tradicional?
        </h2>
        <p class="section-lead-p">
          Un trafficker digital no hace "posts bonitos" ni persigue likes. Como trafficker digital experto, mi único objetivo es diseñar sistemas de compra de tráfico que conviertan clics en facturación real y medible.
        </p>
      </div>

      <div class="grid-3-cards">
        <!-- Tarjeta 1 -->
        <div class="card neo-card">
          <div class="badge-tag magenta-tag">Pilar #1</div>
          <h3>Compra de Tráfico Estratégico</h3>
          <p>
            Gestiono y escalo tu presupuesto en Meta Ads y Google Ads aplicando segmentación avanzada. Un trafficker digital analiza los datos para encontrar el costo por adquisición (CPA) más bajo del mercado.
          </p>
        </div>

        <!-- Tarjeta 2 -->
        <div class="card neo-card">
          <div class="badge-tag dark-tag">Pilar #2</div>
          <h3>Tracking y Analítica Avanzada</h3>
          <p>
            El corazón de mis servicios de trafficker digital. Implemento Server-Side Tracking y flujos de datos con GA4 y GTM para que el algoritmo publicitario reciba información perfecta, incluso sin cookies.
          </p>
        </div>

        <!-- Tarjeta 3 -->
        <div class="card neo-card">
          <div class="badge-tag magenta-tag">Pilar #3</div>
          <h3>Optimización de Embudos (CRO)</h3>
          <p>
            El tráfico no sirve si la página no convierte. Como full-stack marketer y trafficker digital, audito y ajusto técnicamente tus landing pages para asegurar que cada dólar invertido retorne con ganancia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Barra de Autoridad Tecnológica -->
  <section class="tech-bar-strip">
    <div class="container text-center">
      <span class="tech-strip-label">TECNOLOGÍAS QUE USAMOS PARA BLINDAR TU TRACKING:</span>
      <div class="tech-badges-row">
        {[
          "Google Analytics 4",
          "Google Tag Manager",
          "Meta Conversions API",
          "Astro",
          "Node.js"
        ].map((tech) => (
          <div class="tech-chip">⚡ {tech}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Problema / Solución (Diagnóstico de 3 Errores) -->
  <section class="section problem-section">
    <div class="container">
      <div class="section-intro-header text-center">
        <span class="badge-tag magenta-tag">Diagnóstico Técnico</span>
        <h2 class="section-h2">¿Estás quemando dinero en tráfico que no convierte?</h2>
      </div>

      <div class="grid-3-cards">
        <!-- Error 1 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="badge-tag magenta-tag">Error #1</div>
            <h3>El Píxel Ciego</h3>
            <p>
              Con las nuevas políticas de privacidad, pierdes hasta el 40% de las ventas. Implemento Server-Side Tracking para que el algoritmo siempre sepa quién te compra.
            </p>
          </div>
          <div class="card-footer-tag">⚡ Solución: Meta CAPI + GTM Server</div>
        </div>

        <!-- Error 2 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="badge-tag dark-tag">Error #2</div>
            <h3>Landings Lentas</h3>
            <p>
              Si tu web tarda 5 segundos en cargar, ya perdiste al prospecto. Desarrollo páginas de aterrizaje ultra-rápidas enfocadas 100% en disparar tu tasa de conversión.
            </p>
          </div>
          <div class="card-footer-tag">⚡ Solución: Astro + CRO de alta velocidad</div>
        </div>

        <!-- Error 3 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="badge-tag magenta-tag">Error #3</div>
            <h3>Leads de Baja Calidad</h3>
            <p>
              Dejamos de rogar por clics. Conectamos tus campañas a embudos automatizados que filtran a los curiosos y te entregan prospectos listos para cerrar.
            </p>
          </div>
          <div class="card-footer-tag">⚡ Solución: Funnels B2B & Webhooks</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Captación TOFU (Lead Magnet Limpio) -->
  <section class="section tofu-lead-section">
    <div class="container max-w-tofu">
      <!-- Componente interactivo React LeadMagnet -->
      <LeadMagnet client:visible />
    </div>
  </section>

  <!-- 6. Servicios BOFU -->
  <section class="section bofu-services-section">
    <div class="container">
      <div class="section-intro-header text-center">
        <span class="badge-tag dark-tag">Servicios Especializados</span>
        <h2 class="section-h2">Ecosistemas de Crecimiento Digital</h2>
      </div>

      <div class="grid-3-cards">
        <!-- Servicio 1 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="service-emoji">🎯</div>
            <h3>Google Ads & Meta Ads</h3>
            <p>
              Campañas de búsqueda de alta intención y pauta disruptiva en redes sociales. Diseñadas para capturar clientes calificados con el menor costo por adquisición.
            </p>
          </div>
          <div class="service-links-box flex-column">
            <a href="/servicios/trafficker-google-ads">Google Ads &rarr;</a>
            <a href="/servicios/trafficker-facebook-ads">Meta Ads & Instagram &rarr;</a>
          </div>
        </div>

        <!-- Servicio 2 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="service-emoji">📊</div>
            <h3>Analítica Web Avanzada</h3>
            <p>
              Auditoría e implementación de GTM, GA4 y flujos de datos del servidor (Server-Side Tracking). Medición matemática exacta sin discrepancias de conversión.
            </p>
          </div>
          <div class="service-links-box">
            <a href="/servicios/analitica-web-tracking">Analítica & Tracking &rarr;</a>
          </div>
        </div>

        <!-- Servicio 3 -->
        <div class="card neo-card flex-between">
          <div>
            <div class="service-emoji">⚙️</div>
            <h3>Automatización y Desarrollo</h3>
            <p>
              Integración de webhooks, CRMs y optimización técnica de tu sitio web mediante Landing Pages CRO ultra-rápidas construidas para convertir visitantes en ventas.
            </p>
          </div>
          <div class="service-links-box">
            <a href="/servicios/cro-landing-pages">Landing Pages & CRO &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Cierre Final (Pre-Footer) -->
  <section class="section final-callout-section text-center">
    <div class="container">
      <h2 class="final-cta-h2">
        Es hora de dejar de adivinar y empezar a medir.
      </h2>
      
      <div class="cta-center-align">
        <a href="/servicios" class="btn-brutalist-hero big-btn" id="home-bottom-cta">
          COTIZAR MI ESTRATEGIA AHORA ➔
        </a>
      </div>
    </div>
  </section>
</Layout>

<!-- Script para la Terminal Interactiva -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var answers = { 1: null, 2: null, 3: null };
    var buttons = document.querySelectorAll('.answer-btn');
    var resultBox = document.getElementById('terminal-result');

    if (!buttons || !resultBox) return;

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var target = e.currentTarget;
        var questionDiv = target.closest('.terminal-question');
        if (!questionDiv) return;
        var qId = questionDiv.getAttribute('data-question');
        var val = target.getAttribute('data-val');

        questionDiv.querySelectorAll('.answer-btn').forEach(function(b) {
          b.classList.remove('active-yes', 'active-no');
        });

        if (val === 'yes') {
          target.classList.add('active-yes');
        } else {
          target.classList.add('active-no');
        }

        answers[qId] = val;
        evaluateDiagnostics();
      });
    });

    function evaluateDiagnostics() {
      var answeredCount = Object.keys(answers).filter(function(k) { return answers[k] !== null; }).length;
      if (answeredCount === 3) {
        var hasError = Object.keys(answers).some(function(k) { return answers[k] === 'no'; });
        resultBox.style.display = 'block';

        if (hasError) {
          resultBox.innerHTML = `
            <p class="res-title danger">[FATAL] Infraestructura vulnerable.</p>
            <p class="res-detail">> Fuga estimada: ~40% del presupuesto.</p>
            <p class="res-detail">> Diagnóstico: El algoritmo está optimizando a ciegas.</p>
            <a href="/servicios" class="res-btn danger-btn">
              >> PARAR FUGA DE DINERO AHORA
            </a>
          `;
        } else {
          resultBox.innerHTML = `
            <p class="res-title success">[OK] Infraestructura sólida.</p>
            <p class="res-detail">> Ecosistema de datos verificado.</p>
            <p class="res-detail">> Diagnóstico: Listo para inyectar presupuesto agresivo.</p>
            <a href="/servicios" class="res-btn success-btn">
              >> ESCALAR CAMPAÑAS HOY
            </a>
          `;
        }
      }
    }
  });
</script>

<style>
  /* Base Container */
  .container {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .max-w-tofu {
    max-width: 850px;
  }

  /* 1. Hero Section */
  .hero-section {
    padding: 3.5rem 0 4.5rem 0;
    background-color: #ffffff;
    border-bottom: 4px solid #09090b;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-left-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .badge-tag {
    display: inline-block;
    background-color: #09090b;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border: 3px solid #09090b;
    box-shadow: 3px 3px 0px #09090b;
    margin-bottom: 1.25rem;
  }

  .badge-tag.magenta-tag {
    background-color: #f43f5e;
  }

  .badge-tag.dark-tag {
    background-color: #09090b;
  }

  .hero-main-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    font-weight: 900;
    color: #09090b;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }


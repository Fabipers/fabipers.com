---
import Layout from '../layouts/Layout.astro';
import LeadMagnet from '../components/LeadMagnet';

// SEO Title & Description
const title = "Fabipers | Trafficker Digital Colombia & Full Stack Marketer";
const description = "Impulsa tus ventas con un Trafficker Digital experto. Estrategias de pauta en Google Ads y Meta Ads diseñadas para escalar la facturación de tu negocio.";
---

<Layout title={title} description={description}>
  <!-- 1. Hero Section (Above the Fold) -->
  <section class="hero-section">
    <div class="container hero-grid">
      <!-- Columna Izquierda (Textos & CTA) -->
      <div class="hero-left">
        <div class="badge-tag">
          ⚡ FABIÁN PÉREZ
        </div>
        
        <h1 class="hero-title">
          Trafficker Digital para negocios que están <span class="highlight-magenta">cansados de quemar dinero</span> en Ads.
        </h1>
        
        <p class="hero-subtitle">
          No hago "anuncios bonitos". Construyo ecosistemas de adquisición B2B y E-commerce con Server-Side Tracking, automatización y embudos de alta conversión en Google y Meta Ads.
        </p>
        
        <div class="hero-cta-wrapper">
          <a href="/servicios" class="btn-cta-primary" id="hero-main-cta">
            <span>CALCULA EL PRESUPUESTO DE TU ESTRATEGIA</span>
            <span class="arrow">➔</span>
          </a>
        </div>
        
        <p class="trust-note">
          🔒 Arquitectura basada en datos exactos. Sin presupuestos al azar.
        </p>
      </div>

      <!-- Columna Derecha (Gráfico Dinámico Animado) -->
      <div class="hero-right">
        <div class="chart-container-brutalist">
          <div class="roi-floating-badge">ROI +340%</div>
          <div class="chart-bar bar-low"></div>
          <div class="chart-bar bar-mid"></div>
          <div class="chart-bar bar-high">
            <div class="bar-shimmer"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NUEVA SECCIÓN: ¿Qué hace un Trafficker Digital Experto? -->
  <section class="section seo-section">
    <div class="container">
      <div class="section-header text-center max-w-header">
        <span class="badge-tag dark-tag">
          SEO & ESTRATEGIA
        </span>
        <h2 class="section-title">
          ¿Por qué tu negocio necesita un Trafficker Digital y no una agencia de vanidad?
        </h2>
        <p class="section-intro">
          Un trafficker digital no hace "posts bonitos" ni persigue likes. Como trafficker digital experto, mi único objetivo es diseñar sistemas de compra de tráfico que conviertan clics en facturación real y medible.
        </p>
      </div>

      <div class="grid-3-col">
        <!-- Tarjeta 1 -->
        <div class="card card-brutalist">
          <div>
            <div class="badge-tag magenta-badge">Pilar #1</div>
            <h3>Compra de Tráfico Estratégico</h3>
            <p>
              Gestiono y escalo tu presupuesto en Meta Ads y Google Ads aplicando segmentación avanzada. Un trafficker digital analiza los datos para encontrar el costo por adquisición (CPA) más bajo del mercado.
            </p>
          </div>
        </div>

        <!-- Tarjeta 2 -->
        <div class="card card-brutalist">
          <div>
            <div class="badge-tag dark-badge">Pilar #2</div>
            <h3>Tracking y Analítica Avanzada</h3>
            <p>
              El corazón de mis servicios de trafficker digital. Implemento Server-Side Tracking y flujos de datos con GA4 y GTM para que el algoritmo publicitario reciba información perfecta, incluso sin cookies.
            </p>
          </div>
        </div>

        <!-- Tarjeta 3 -->
        <div class="card card-brutalist">
          <div>
            <div class="badge-tag magenta-badge">Pilar #3</div>
            <h3>Optimización de Embudos (CRO)</h3>
            <p>
              El tráfico no sirve si la página no convierte. Como full-stack marketer y trafficker digital, audito y ajusto técnicamente tus landing pages para asegurar que cada dólar invertido retorne con ganancia.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Barra de Autoridad Tecnológica -->
  <section class="tech-bar-section">
    <div class="container text-center">
      <span class="tech-bar-title">
        TECNOLOGÍAS QUE USAMOS PARA BLINDAR TU TRACKING:
      </span>
      <div class="tech-tags-wrapper">
        {[
          "Google Analytics 4",
          "Google Tag Manager",
          "Meta Conversions API",
          "Astro",
          "Node.js"
        ].map((tech) => (
          <div class="tech-badge">
            ⚡ {tech}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Problema / Solución (Grid de 3 columnas) -->
  <section class="section problem-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge-tag magenta-tag">Diagnóstico Técnico</span>
        <h2 class="section-title">¿Estás quemando dinero en tráfico que no convierte?</h2>
      </div>

      <div class="grid-3-col">
        <!-- Caja 1 -->
        <div class="card card-brutalist space-between-card">
          <div>
            <div class="badge-tag magenta-badge">Error #1</div>
            <h3>El Píxel Ciego</h3>
            <p>
              Con las nuevas políticas de privacidad, el píxel tradicional pierde hasta el 40% de las ventas. Implemento Server-Side Tracking para que el algoritmo siempre sepa quién te compra.
            </p>
          </div>
          <div class="solution-footer">⚡ Solución: Meta CAPI + GTM Server</div>
        </div>

        <!-- Caja 2 -->
        <div class="card card-brutalist space-between-card">
          <div>
            <div class="badge-tag dark-badge">Error #2</div>
            <h3>Landings Lentas</h3>
            <p>
              Si tu web tarda 5 segundos en cargar, ya perdiste al prospecto. Desarrollo páginas de aterrizaje ultra-rápidas enfocadas 100% en disparar tu tasa de conversión.
            </p>
          </div>
          <div class="solution-footer">⚡ Solución: Astro + CRO de alta velocidad</div>
        </div>

        <!-- Caja 3 -->
        <div class="card card-brutalist space-between-card">
          <div>
            <div class="badge-tag magenta-badge">Error #3</div>
            <h3>Leads de Baja Calidad</h3>
            <p>
              Dejamos de rogar por clics. Conectamos tus campañas a embudos automatizados que filtran a los curiosos y te entregan prospectos listos para cerrar.
            </p>
          </div>
          <div class="solution-footer">⚡ Solución: Funnels B2B & Webhooks</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Captación TOFU (Lead Magnet) -->
  <section class="section tofu-section">
    <div class="container">
      <div class="tofu-banner-card">
        <div class="badge-tag dark-tag">🎁 Recursos Gratuitos</div>
        
        <h2 class="tofu-title">
          ¿Aún no estás listo para escalar? Empieza cerrando la fuga de dinero.
        </h2>
        
        <p class="tofu-text">
          Descarga gratis el <span class="yellow-highlight">Checklist de Auditoría: Los 5 Errores Ocultos en tus Campañas de Ads</span> y aprende los ajustes técnicos para detener la fuga hoy mismo.
        </p>

        <!-- Interactive Lead Magnet Form -->
        <LeadMagnet client:visible />
      </div>
    </div>
  </section>

  <!-- 6. Servicios BOFU -->
  <section class="section bofu-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge-tag dark-tag">Servicios Especializados</span>
        <h2 class="section-title">Ecosistemas de Crecimiento Digital</h2>
      </div>

      <div class="grid-3-col">
        <!-- Ítem 1 -->
        <div class="card card-brutalist space-between-card">
          <div>
            <div class="icon-emoji">🎯</div>
            <h3>Google Ads & Meta Ads</h3>
            <p>
              Campañas de búsqueda de alta intención y pauta disruptiva en redes sociales. Diseñadas para capturar clientes calificados con el menor costo por adquisición.
            </p>
          </div>
          <div class="service-nav-links vertical-links">
            <a href="/servicios/trafficker-google-ads">Google Ads &rarr;</a>
            <a href="/servicios/trafficker-facebook-ads">Meta Ads & Instagram &rarr;</a>
          </div>
        </div>

        <!-- Ítem 2 -->
        <div class="card card-brutalist space-between-card">
          <div>
            <div class="icon-emoji">📊</div>
            <h3>Analítica Web Avanzada</h3>
            <p>
              Auditoría e implementación de GTM, GA4 y flujos de datos del servidor (Server-Side Tracking). Medición matemática exacta sin discrepancias de conversión.
            </p>
          </div>
          <div class="service-nav-links">
            <a href="/servicios/analitica-web-tracking">Analítica & Tracking &rarr;</a>
          </div>
        </div>

        <!-- Ítem 3 -->
        <div class="card card-brutalist space-between-card">
          <div>
            <div class="icon-emoji">⚙️</div>
            <h3>Automatización y Desarrollo</h3>
            <p>
              Integración de webhooks, CRMs y optimización técnica de tu sitio web mediante Landing Pages CRO ultra-rápidas construidas para convertir visitantes en ventas.
            </p>
          </div>
          <div class="service-nav-links">
            <a href="/servicios/cro-landing-pages">Landing Pages & CRO &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Cierre Final (Pre-Footer) -->
  <section class="section final-cta-section text-center">
    <div class="container">
      <h2 class="final-headline">
        Es hora de dejar de adivinar y empezar a medir.
      </h2>
      
      <div class="hero-cta-wrapper center-flex">
        <a href="/servicios" class="btn-cta-primary big-cta" id="home-bottom-cta">
          <span>COTIZAR MI ESTRATEGIA AHORA</span>
          <span class="arrow">➔</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* 1. Hero Section */
  .hero-section {
    padding-top: 4rem;
    padding-bottom: 4.5rem;
    background-color: #ffffff;
    border-bottom: 4px solid #09090b;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .badge-tag {
    display: inline-block;
    background-color: #09090b;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border: 3px solid #09090b;
    box-shadow: 3px 3px 0px #09090b;
    margin-bottom: 1.5rem;
  }

  .badge-tag.magenta-badge {
    background-color: #f43f5e;
  }

  .badge-tag.dark-badge {
    background-color: #09090b;
  }

  .badge-tag.magenta-tag {
    background-color: #f43f5e;
    box-shadow: 3px 3px 0px #09090b;
  }

  .hero-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(2.2rem, 4.8vw, 3.5rem);
    font-weight: 900;
    text-transform: none;
    color: #09090b;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .highlight-magenta {
    background-color: #f43f5e;
    color: #ffffff;
    padding: 0.15rem 0.5rem;
    border: 2px solid #09090b;
    box-shadow: 4px 4px 0px #09090b;
    display: inline-block;
    transform: rotate(-1deg);
    margin: 0.1rem 0;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 600;
    color: #27272a;
    line-height: 1.65;
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .hero-cta-wrapper {
    display: flex;
    width: 100%;
  }

  .hero-cta-wrapper.center-flex {
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    background-color: #f43f5e;
    color: #ffffff;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-weight: 900;
    font-size: clamp(1rem, 2vw, 1.2rem);
    text-transform: uppercase;
    padding: 1.1rem 2rem;
    border: 4px solid #09090b;
    box-shadow: 6px 6px 0px #09090b;
    text-decoration: none;
    line-height: 1.2;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-cta-primary:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0px #09090b;
    color: #ffffff;
  }

  .btn-cta-primary:active {
    transform: translate(6px, 6px);
    box-shadow: 0px 0px 0px #09090b;
  }

  .btn-cta-primary.big-cta {
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    padding: 1.25rem 2.5rem;
    box-shadow: 8px 8px 0px #09090b;
  }

  .trust-note {
    font-size: 0.85rem;
    font-weight: 700;
    color: #71717a;
    margin-top: 0.85rem;
  }

  /* Right Chart Graphic */
  .hero-right {
    display: flex;
    justify-content: center;
  }

  .chart-container-brutalist {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    background-color: #ffffff;
    border: 4px solid #09090b;
    box-shadow: 12px 12px 0px #09090b;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    gap: 1rem;
    margin: 0 auto;
  }

  .roi-floating-badge {
    position: absolute;
    top: -20px;
    right: -20px;
    background-color: #f43f5e;
    color: #ffffff;
    font-weight: 900;
    font-size: 1.15rem;
    padding: 0.5rem 1rem;
    border: 4px solid #09090b;
    box-shadow: 6px 6px 0px #09090b;
    animation: bounce 3s infinite;
  }

  .chart-bar {
    width: 100%;
    border: 4px solid #09090b;
  }

  .bar-low {
    background-color: #f1f5f9;
    height: 40%;
    animation: pulse 2s ease-in-out infinite;
  }

  .bar-mid {
    background-color: #09090b;
    height: 60%;
    animation: pulse 3s ease-in-out infinite 0.5s;
  }

  .bar-high {
    background-color: #f43f5e;
    height: 85%;
    position: relative;
    overflow: hidden;
  }

  .bar-shimmer {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.3);
    animation: bounce 4s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  /* 2. SEO Section */
  .seo-section {
    padding: 5rem 0;
    background-color: #ffffff;
    border-bottom: 4px solid #09090b;
  }

  .max-w-header {
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .section-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: #09090b;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .section-intro {
    font-size: 1.05rem;
    font-weight: 600;
    color: #27272a;
    line-height: 1.65;
  }

  .grid-3-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .card-brutalist {
    background-color: #ffffff;
    border: 4px solid #09090b;
    box-shadow: 8px 8px 0px #09090b;
    padding: 2rem;
  }

  .space-between-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-brutalist h3 {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 1.35rem;
    font-weight: 900;
    color: #09090b;
    margin-bottom: 0.75rem;
  }

  .card-brutalist p {
    font-size: 0.95rem;
    font-weight: 500;
    color: #3f3f46;
    line-height: 1.6;
  }

  /* 3. Tech Bar */
  .tech-bar-section {
    padding: 2.5rem 0;
    background-color: #f1f5f9;
    border-bottom: 4px solid #09090b;
  }

  .tech-bar-title {
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #71717a;
    margin-bottom: 1.25rem;
    display: block;
  }

  .tech-tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .tech-badge {
    background-color: #ffffff;
    color: #09090b;
    font-weight: 900;
    font-size: 0.85rem;
    text-transform: uppercase;
    padding: 0.6rem 1.1rem;
    border: 3px solid #09090b;
    box-shadow: 3px 3px 0px #09090b;
  }

  /* 4. Problem / Solution */
  .problem-section {
    padding: 5rem 0;
    background-color: #ffffff;
    border-bottom: 4px solid #09090b;
  }

  .solution-footer {
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    padding-top: 1rem;
    margin-top: 1.5rem;
    border-top: 2px dashed #e4e4e7;
  }

  /* 5. TOFU Lead Magnet Section */
  .tofu-section {
    padding: 4rem 0;
    background-color: #09090b;
    border-bottom: 4px solid #09090b;
  }

  .tofu-banner-card {
    background-color: #f43f5e;
    border: 4px solid #09090b;
    box-shadow: 10px 10px 0px #09090b;
    padding: 2.5rem 2rem;
    color: #ffffff;
    max-width: 900px;
    margin: 0 auto;
  }

  .tofu-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.5rem, 3.5vw, 2.3rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .tofu-text {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .yellow-highlight {
    background-color: #09090b;
    color: #facc15;
    padding: 0.2rem 0.5rem;
    border: 2px solid #09090b;
    display: inline-block;
    font-weight: 900;
  }

  /* 6. BOFU Services */
  .bofu-section {
    padding: 5rem 0;
    background-color: #ffffff;
    border-bottom: 4px solid #09090b;
  }

  .icon-emoji {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .service-nav-links {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    margin-top: 1.5rem;
    border-top: 2px dashed #e4e4e7;
  }

  .service-nav-links.vertical-links {
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-nav-links a {
    font-size: 0.85rem;
    font-weight: 900;
    text-transform: uppercase;
    color: #f43f5e;
    text-decoration: none;
  }

  .service-nav-links a:hover {
    text-decoration: underline;
  }

  /* 7. Final Pre-Footer CTA */
  .final-cta-section {
    padding: 6rem 0;
    background-color: #f1f5f9;
    border-bottom: 4px solid #09090b;
  }

  .final-headline {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    font-weight: 900;
    text-transform: uppercase;
    color: #09090b;
    line-height: 1.15;
    max-width: 850px;
    margin: 0 auto;
  }
</style>
